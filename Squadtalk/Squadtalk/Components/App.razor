    <link href="manifest.webmanifest" rel="manifest" />
    <link rel="apple-touch-icon" sizes="512x512" href="icon-512.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="icon-192.png" />
    <HeadOutlet @rendermode="@RenderModeForPage"/>
</head>

<body>
    <Routes @rendermode="@RenderModeForPage" />
    <script src="_framework/blazor.web.js"></script>
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script> *@
    @* <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.0.1/chart.umd.js" integrity="sha512-gQhCDsnnnUfaRzD8k1L5llCCV6O9HN09zClIzzeJ8OJ9MpGmIlCxm+pdCkqTwqJ4JcjbojFr79rl2F1mzcoLMQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script> *@
    @* <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js" integrity="sha512-JPcRR8yFa8mmCsfrw4TNte1ZvF1e3+1SdGMslZvmrzDYxS69J7J49vkFL8u6u8PlPJK+H3voElBtUCzaXj+6ig==" crossorigin="anonymous" referrerpolicy="no-referrer"></script> *@
    @* <script src="_content/Blazor.Bootstrap/blazor.bootstrap.js"></script> *@
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/tus.min.js"></script>
    <script>navigator.serviceWorker.register('service-worker.js');</script>
    <script src="https://cdn.jsdelivr.net/npm/livekit-client/dist/livekit-client.umd.min.js"></script>
    <script>
        window.getPreferredLanguage = () => {
            function getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(';').shift();
            }

            const languageFromCookie = getCookie('UserLanguage');
            if (languageFromCookie) {
                return languageFromCookie;
            }

            return navigator.language || navigator.userLanguage;
        };

        window.savePreferredLanguage = (language) => {
            document.cookie = `UserLanguage=${language}; SameSite=Strict`;

            console.log(document.cookie);
        }
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private bool ServerSide { get; set; }
    
    private bool IsOnAccountManagePage => HttpContext.Request.Path.StartsWithSegments("/Account");
    private bool ClientRequestedServerSide => ServerSide;

    private IComponentRenderMode? RenderModeForPage => (IsOnAccountManagePage, ClientRequestedServerSide) switch
    {
        (true, _) => null,
        (false, true) => InteractiveServer,
        _ => InteractiveWebAssembly
    };
}
