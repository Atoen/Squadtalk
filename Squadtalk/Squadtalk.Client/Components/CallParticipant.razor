@using Shared.Data.TypedIds
@implements IDisposable
@inject IVoiceChatServiceOld VoiceChatServiceOld
@inject ILogger<CallParticipantModelOld> Logger

@code {

    [Parameter, EditorRequired] public CallParticipantModelOld ModelOld { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        VoiceChatServiceOld.ParticipantUpdated += ParticipantUpdated;
        _volume = await VoiceChatServiceOld.GetUserVolumeAsync(ModelOld);
    }

    private void ParticipantUpdated(UserId userId, ChatModel chatModel)
    {
        if (ModelOld.Id == userId)
        {
            StateHasChanged();
        }
    }

    private int _volume;

    private int Volume => ModelOld.Volume.Value;
    private bool _firstChange = true;

    private async Task VolumeChanged(int value)
    {
        if (_firstChange)
        {
            _firstChange = false;
            return;
        }

        _volume = value;
        await VoiceChatServiceOld.ChangeVolumeAsync(ModelOld, new Volume(value));
    }

    private Task ShowCamera() => VoiceChatServiceOld.MaximizeVideoAsync(ModelOld, VideoSource.Camera);

    private Task ShowScreenShare() => VoiceChatServiceOld.MaximizeVideoAsync(ModelOld, VideoSource.ScreenShare);

    private string AvatarBorderStyle => ModelOld.IsSpeaking ? "border-color: limegreen;" : string.Empty;

