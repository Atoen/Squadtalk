<MudPaper class="rounded d-flex flex-column my-1 align-center pa-1 mud-ripple flex-auto"
          MaxWidth="120px" MinWidth="100px">
    @UserAvatar.NoBadgeMedium(Participant.User)
    @Participant.Username

    <div class="d-flex gap-1 mt-1">
        @if (Participant.IsRemote)
        {
            <MudMenu Icon="@VolumeIcon" Size="Size.Small" Dense="true">
                <MudSlider @bind-Value="_volumeFraction" Class="ps-5 pe-6 pt-6 pb-1"
                           Size="Size.Small" ValueLabel="true" ValueLabelFormat="P0"
                           Max="1" Step="0.01"/>
            </MudMenu>
        }

        <MudIcon Icon="@Participant.ConnectionQuality.Icon()"
                 Color="@Participant.ConnectionQuality.IconColor()"/>

        <MudIcon Icon="@MicIcon" Color="MicIconColor"/>
    </div>
</MudPaper>

@implements ISubscriber
@implements IDisposable

@inject LocalizedText LocalizedText

@code
{
    [Parameter, EditorRequired]
    public CallParticipantModel Participant { get; set; } = default!;

    private double _volumeFraction;

    private string VolumeIcon => (_volumeFraction * 100) switch
    {
        0 => Icons.Material.Rounded.VolumeOff,
        < 20 => Icons.Material.Rounded.VolumeMute,
        < 80 => Icons.Material.Rounded.VolumeDown,
        _ => Icons.Material.Rounded.VolumeUp
    };

    private string MicIcon => Participant.MicrophoneEnabled
        ? Icons.Material.Rounded.Mic
        : Icons.Material.Rounded.MicOff;

    private Color MicIconColor
    {
        get
        {
            if (!Participant.MicrophoneEnabled) return Color.Error;
            return Participant.IsSpeaking ? Color.Success : Color.Default;
        }
    }

    protected override void OnInitialized() => _subscription = Participant.Subscribe(this);

    private IDisposable? _subscription;

    public void OnChange() => StateHasChanged();

    public void Dispose() => _subscription?.Dispose();
}
