@using Microsoft.AspNetCore.Components.Rendering
@using Shared.Data.TypedIds

@if (ChannelManager.CurrentChannel is { State.ScrolledToBeginning: true } channel)
{
    <div class="channel-start">
        <div class="title">@channel.Name</div>
        <div>
            @LocalizedText.R.channel_beginning <span class="channel-start-name">@channel.Name</span>.
        </div>
    </div>
}

@if (DisplaySkeleton)
{
    <MudStack Row="true" Class="ms-1 mb-1" Spacing="1">
        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" Animation="Animation.Wave"/>
        <MudStack Spacing="0">
            <MudSkeleton Width="100px" Animation="Animation.Wave"/>
            <MudSkeleton Height="60px" Width="200px" Class="my-n2" Animation="Animation.Wave"/>
            <MudSkeleton Height="20px" Width="160px" Animation="Animation.Wave"/>
        </MudStack>
    </MudStack>

    <MudStack Row="true" Class="ms-1 mb-1" Spacing="1">
        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" Animation="Animation.Wave"/>
        <MudStack Spacing="0">
            <MudSkeleton Width="80px" Animation="Animation.Wave"/>
            <MudSkeleton Height="40px" Width="200px" Class="my-n2" Animation="Animation.Wave"/>
        </MudStack>
    </MudStack>
}

@* ReSharper disable once CSharpWarnings::CS8974 *@
@RenderLastElement

@if (ChannelManager.CurrentChannelState is not null && ItemTemplate is not null)
{
    foreach (var item in ChannelManager.CurrentChannelState.Messages)
    {
        @ItemTemplate(item)
    }
}

@implements IDisposable

@inject IJSRuntime JsRuntime
@inject IChannelManager ChannelManager
@inject ITextChatService TextChatService
@inject LocalizedText LocalizedText
@inject ILogger<InfiniteScrolling> Logger

@code
{
    private IJSInProcessRuntime _inProcessRuntime = default!;

    private ElementReference _lastItemIndicator;
    private DotNetObjectReference<InfiniteScrolling>? _currentComponentReference;
    private IJSInProcessObjectReference? _jsModule;
    private IJSInProcessObjectReference? _instance;

    private bool _beforeFirstLoad = true;
    private bool _loading;
    private bool _changedChannel;

    private bool DisplaySkeleton => _loading || _beforeFirstLoad;

    [Parameter, EditorRequired]
    public RenderFragment<MessageModel>? ItemTemplate { get; set; }

    protected override void OnInitialized()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _inProcessRuntime = (IJSInProcessRuntime) JsRuntime;

        TextChatService.MessageReceived += MessageReceived;
        ChannelManager.ChannelChangedAsync += ChannelChangedAsync;
    }

    private async Task ChannelChangedAsync()
    {
        _changedChannel = true;
        
        await LoadMoreItems();

        _instance?.InvokeVoid("onNewItems");
    }

    private void MessageReceived(ChannelId id, MessageModel message)
    {
        if (id != ChannelManager.CurrentChannel?.Id)
        {
            return;
        }

        StateHasChanged();
        _jsModule?.InvokeVoid("scrollToBottom");
    }

    [JSInvokable]
    public async Task LoadMoreItems()
    {
        if (_loading) return;
        if (ChannelManager.CurrentChannel is not { } channel) return;
        
        _loading = true;
        _beforeFirstLoad = false;
        
        var channelState = channel.State;

        if (channelState is { ScrolledToBeginning: false } && !_changedChannel)
        {
            StateHasChanged();
            
            try
            {
                var newItems = await TextChatService.GetMessagePageAsync(channel.Id, CancellationToken.None);
                if (newItems.Count == 0)
                {
                    channelState.ScrolledToBeginning = true;
                }
                else
                {
                    Logger.LogInformation("Loaded {Count} messages", newItems.Count);
                    channelState.Messages.InsertRange(0, newItems);
                    _instance?.InvokeVoid("onNewItems");
                }
            }
            catch (Exception e)
            {
                Logger.LogError(e, "Error while loading message page");
            }
        }

        var scrollPosition = _jsModule?.Invoke<double>("markScroll");
        if (_changedChannel)
        {
            scrollPosition = 0;
            _changedChannel = false;
        }

        _loading = false;
        
        StateHasChanged();
        _jsModule?.InvokeVoid("scrollToMark", scrollPosition);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
    
        _jsModule = await _inProcessRuntime
            .InvokeAsync<IJSInProcessObjectReference>("import", "../Components/InfiniteScrolling.razor.js");
        
        _currentComponentReference = DotNetObjectReference.Create(this);
        _instance = _jsModule
            .Invoke<IJSInProcessObjectReference>("initialize", _lastItemIndicator, _currentComponentReference);
        
        _jsModule.InvokeVoid("scrollToMark", 0);
    }

    public void Dispose()
    {
        _instance?.InvokeVoid("dispose");
        _instance?.Dispose();

        _jsModule?.Dispose();
        _currentComponentReference?.Dispose();

        TextChatService.MessageReceived -= MessageReceived;
        ChannelManager.ChannelChangedAsync -= ChannelChangedAsync;
    }

    private void RenderLastElement(RenderTreeBuilder builder)
    {
        builder.OpenElement(1000, "div");

        var style = ChannelManager.CurrentChannelState is { ScrolledToBeginning: true }
            ? "height:0;width:0"
            : "height:1px;width:1px;flex-shrink:0";
        
        builder.AddAttribute(1001, "style", style);
        builder.AddElementReferenceCapture(1002, element => _lastItemIndicator = element);
        builder.CloseElement();
    }
}
