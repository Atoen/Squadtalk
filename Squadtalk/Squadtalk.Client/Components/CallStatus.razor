<MudPaper class="d-flex flex-column align-center mud-width-full rounded-t-0">

    @if (RtcConnectionService.CallChat == Chat)
    {
        <div class="gap-1 mud-width-full d-flex flex-wrap justify-center px-1">
            @foreach (var participant in RtcConnectionService.CallParticipants)
            {
                <CallParticipant Participant="participant"/>
            }
        </div>

        <CallMediaControls/>
    }
    else
    {
        <div @onclick="JoinExistingCall">Join voice call: @Chat.Name</div>
    }

</MudPaper>

@implements ISubscriber
@implements IDisposable

@inject IRtcConnectionService RtcConnectionService
@inject IContactManager ContactManager

@code
{
    [Parameter, EditorRequired]
    public ChatModel Chat { get; set; } = default!;

    protected override void OnInitialized() => _subscription = RtcConnectionService.CallParticipants.Subscribe(this);

    private IDisposable? _subscription;

    public void OnChange() => StateHasChanged();

    public void Dispose() => _subscription?.Dispose();

    private async Task JoinExistingCall()
    {
        await RtcConnectionService.AcceptCallAsync(Chat);
    }
}