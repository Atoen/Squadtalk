<div class="d-flex flex-column align-center mud-width-full">
    <div class="gap-1 mud-width-full d-flex flex-wrap justify-center">
        @foreach (var participant in _callParticipants)
        {
            <CallParticipant Participant="participant"/>
        }
    </div>

    <CallMediaControls/>
</div>

@inject IContactManager ContactManager

@code
{
    [Parameter, EditorRequired]
    public ChatModel Chat { get; set; } = default!;

    private readonly List<CallParticipantModel> _callParticipants = [];

    protected override void OnInitialized()
    {
        _callParticipants.Add(new CallParticipantModel(ContactManager.LocalUserModel)
        {
           ConnectionQuality = ConnectionQuality.Excellent,
           IsSpeaking = false,
           MicrophoneEnabled = true
        });

        _callParticipants.Add(new CallParticipantModel(ContactManager.FriendList.First())
        {
           ConnectionQuality = ConnectionQuality.Good,
           IsSpeaking = true,
           MicrophoneEnabled = true
        });

        _callParticipants.Add(new CallParticipantModel(ContactManager.FriendList.Skip(1).First())
        {
           ConnectionQuality = ConnectionQuality.Poor,
           IsSpeaking = false,
           MicrophoneEnabled = false
       });
    }
}