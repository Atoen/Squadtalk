@using Squadtalk.Client.Extensions

<div class="image-container @SmallClass">
    @if (Channel is DirectMessageChannelModel dm)
    {
        <img alt="@dm.Name avatar" src="@dm.Other.AvatarUrl" class="image @SmallClass"/>
        <div class="online-indicator @SmallClass" style="@GetStyle"></div>
    }
    else if (Channel is GroupChatModel groupChat)
    {
        if (groupChat.ImageUrl is not null)
        {
            <img alt="@groupChat.Name image" src="@groupChat.ImageUrl" class="image @SmallClass"/>
        }
        else
        {
            foreach (var user in groupChat.Others.Take(2))
            {
                <img alt="@user.Username Avatar" src="@user.AvatarUrl" class="group-avatar-item @SmallClass"/>
            }
        }

        <div class="online-indicator @SmallClass" style="@GetStyle"></div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ChannelModel Channel { get; set; } = default!;

    [Parameter]
    public bool Inline { get; set; }

    private string GetStyle => $"background-color: {Channel.StatusColor()}";
    private string SmallClass => Inline ? "inline" : "";
}
