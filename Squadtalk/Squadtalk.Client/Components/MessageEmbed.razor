@using Shared.Extensions
@using Shared
@if (_showOverlay)
{
    <div class="image-overlay-parent" @onclick="ToggleOverlay">
        <div>
            <img src="@Model[EmbedData.Url]" alt="Image" class="image-overlay" draggable="false"/>
            <a href="@Model[EmbedData.Url]"
               target="_blank" rel="noopener noreferrer"
               @onclick:stopPropagation="true">
                Download image
            </a>
        </div>
    </div>
}

@switch (Model.Type)
{
    case EmbedType.File:
        <div class="embed rounded">
            <Icon Size="IconSize.x1" Color="IconColor.White" Name="FileIconName" Class="me-2" Style="grid-row: 1/3"/>
            <a class="link" href="@Model.Data[EmbedData.Url]" target="_blank" rel="noopener noreferrer">@Model[EmbedData.FileName]</a>
            <div class="filesize">@FileSizeConverter.ConvertToHumanReadableSize(Model[EmbedData.FileSize])</div>
        </div>
        break;
    case EmbedType.Image:
        if (!_imageLoaded)
        {
            <div class="image-parent" style="max-width: @Model[EmbedData.ImageWidth]px; height: @Model[EmbedData.ImageHeight]px;">
                <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" class="image-placeholder">
                    <g>
                        <path d="M368,224c26.5,0,48-21.5,48-48c0-26.5-21.5-48-48-48c-26.5,0-48,21.5-48,48C320,202.5,341.5,224,368,224z"/>
                        <path d="M452,64H60c-15.6,0-28,12.7-28,28.3v327.4c0,15.6,12.4,28.3,28,28.3h392c15.6,0,28-12.7,28-28.3V92.3   C480,76.7,467.6,64,452,64z M348.9,261.7c-3-3.5-7.6-6.2-12.8-6.2c-5.1,0-8.7,2.4-12.8,5.7l-18.7,15.8c-3.9,2.8-7,4.7-11.5,4.7   c-4.3,0-8.2-1.6-11-4.1c-1-0.9-2.8-2.6-4.3-4.1L224,215.3c-4-4.6-10-7.5-16.7-7.5c-6.7,0-12.9,3.3-16.8,7.8L64,368.2V107.7   c1-6.8,6.3-11.7,13.1-11.7h357.7c6.9,0,12.5,5.1,12.9,12l0.3,260.4L348.9,261.7z"/>
                    </g>
                </svg>
            </div>
        }
        <img src="@Model[EmbedData.PreviewUrl]" alt="@Model.Type" class="image" draggable="false" style="display: @_imageDisplay"
             @onclick="ToggleOverlay"
             @onload="ImageLoaded"/>
        break;
    case EmbedType.Video:
        <div>Video</div>
        break;
    case EmbedType.SystemMessage:
        <div class="system-message">
            <Icon Name="_systemMessageIconName" Color="_systemMessageIconColor" Size="IconSize.x5"/>
            <span class="ms-2">@GetSystemMessageContent()</span>
        </div>
        break;
    default:
        throw new ArgumentOutOfRangeException();
}

@inject ILocalization Localization

@code {
    
    [Parameter, EditorRequired]
    public required EmbedModel Model { get; set; }
    private string _imageDisplay = "none";

    private bool _imageLoaded;
    private bool _showOverlay;

    private FileType _fileType;
    private IconName FileIconName => _fileType switch
    {
        FileType.Pdf => IconName.FileEarmarkPdfFill,
        FileType.Text => IconName.FileEarmarkTextFill,
        FileType.Archive => IconName.FileEarmarkZipFill,
        FileType.Code => IconName.FileEarmarkCodeFill,
        FileType.Video => IconName.FileEarmarkPlayFill,
        FileType.Music => IconName.FileEarmarkMusicFill,
        FileType.Image => IconName.FileEarmarkImageFill,
        _ => IconName.FileEarmarkFill
    };

    private IconName _systemMessageIconName;
    private IconColor _systemMessageIconColor;
    private IconSize _systemMessageIconSize;
    private SystemMessageType _systemMessageType;

    private IconName _lastIcon;

    protected override void OnInitialized()
    {
        _fileType = Model.Type == EmbedType.File
            ? FileModel.GetType(Model[EmbedData.FileName])
            : default;

        SetIcon();
    }

    protected override void OnAfterRender(bool firstRender) => SetIcon();

    private void SetIcon()
    {
        if (Model.Type != EmbedType.SystemMessage) return;

        _systemMessageType = SystemMessageTypeHelper.Parse(Model[EmbedData.SystemMessageType]);
        SetSystemMessageIcon(_systemMessageType);

        if (_systemMessageIconName != _lastIcon) StateHasChanged();
    }

    private void SetSystemMessageIcon(SystemMessageType messageType)
    {
        _lastIcon = _systemMessageIconName;

        _systemMessageIconColor = messageType switch
        {
            SystemMessageType.ChannelCreated or SystemMessageType.ChannelNameChanged => IconColor.None,
            SystemMessageType.CallStarted or SystemMessageType.CallEnded => IconColor.Success,
            SystemMessageType.CallMissed => IconColor.Danger,
            _ => IconColor.None
        };

        _systemMessageIconName = messageType switch
        {
            SystemMessageType.ChannelCreated or SystemMessageType.ChannelNameChanged => IconName.InfoCircle,
            SystemMessageType.CallStarted => IconName.TelephoneOutboundFill,
            SystemMessageType.CallEnded => IconName.TelephoneFill,
            SystemMessageType.CallMissed => IconName.TelephoneXFill,
            _ => IconName.None
        };
    }

    private string GetSystemMessageContent()
    {
        if (Model.Type != EmbedType.SystemMessage) return string.Empty;

        var table = Localization.TextTable;

        switch (_systemMessageType)
        {
            case SystemMessageType.ChannelCreated:
            {
                var username = Model[EmbedData.SystemMessageDataUsername];
                return table.ChannelCreatedTemplate.TryFormat(username);
            }
            case SystemMessageType.ChannelNameChanged:
            {
                var username = Model[EmbedData.SystemMessageDataUsername];
                var newName = Model[EmbedData.SystemMessageDataChannelName];

                return table.ChannelNameChangedTemplate.TryFormat(username, newName);
            }
            case SystemMessageType.CallStarted:
            {
                var username = Model[EmbedData.SystemMessageDataUsername];
                return table.CallStartedTemplate.TryFormat(username);
            }
            case SystemMessageType.CallEnded:
            {
                var username = Model[EmbedData.SystemMessageDataUsername];
                var duration = Model[EmbedData.SystemMessageDataDuration];

                return table.CallEndedTemplate.TryFormat(username, duration);
            }
            case SystemMessageType.CallMissed:
                return "CallMissed";

            case SystemMessageType.None:
            default:
                return string.Empty;
        }
    }

    private void ImageLoaded()
    {
        _imageLoaded = true;
        _imageDisplay = "block";
    }

    private void ToggleOverlay()
    {
        _showOverlay = !_showOverlay;
    }
}
