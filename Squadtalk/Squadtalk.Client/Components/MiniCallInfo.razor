@if (ShouldDisplay)
{
    <div class="info">
        <div class="d-flex gap-1 w-100 align-items-center">
            <Icon Name="ConnectionQualityIcon" Color="ConnectionQualityColor" Size="IconSize.x4"/>
            <span class="channel-name" @onclick="GoToCallChannel">@VoiceChatService.CallChannel?.Name</span>
        </div>

        <div class="d-flex gap-1 w-100">
            <Tooltip Title="@MicrophoneTooltipText" Class="flex-grow-1 d-flex">
                <Button Class="flex-grow-1" Color="MicrophoneButtonColor"
                        Disabled="@(!VoiceChatService.MicrophoneAvailable)"
                        @onclick="VoiceChatService.ToggleMicrophoneAsync">
                    <Icon Name="MicrophoneIconName" Size="IconSize.x6"/>
                </Button>
            </Tooltip>
            <Tooltip Title="@CameraTooltipText" Class="flex-grow-1 d-flex">
                <Button Class="flex-grow-1" Color="CameraButtonColor"
                        Disabled="@(!VoiceChatService.CameraAvailable)"
                        @onclick="VoiceChatService.ToggleMicrophoneAsync">
                    <Icon Name="CameraIconName" Size="IconSize.x6"/>
                </Button>
            </Tooltip>
            <Button Class="flex-grow-1" Color="ScreenShareButtonColor" TooltipTitle="@ScreenShareTooltipText"
                    @onclick="VoiceChatService.ToggleScreenShareAsync">
                <Icon Name="ScreenShareIconName" Size="IconSize.x6"/>
            </Button>
            <Button Class="flex-grow-1" Color="ButtonColor.Danger" TooltipTitle="Leave call"
                    @onclick="VoiceChatService.LeaveCallAsync">
                <Icon Name="IconName.TelephoneXFill" Size="IconSize.x6"/>
            </Button>
        </div>
    </div>
}

@implements IDisposable

@inject IChatService ChatService
@inject IVoiceChatService VoiceChatService
@inject NavigationManager NavigationManager
@inject ILogger<MiniCallInfo> Logger

@code {

    private bool ShouldDisplay => VoiceChatService.ConnectedToVoiceCall;

    private bool _shouldRerenderControls;
    private bool _lastShouldDisplay;

    private ButtonColor MicrophoneButtonColor => VoiceChatService.MicrophoneEnabled ? ButtonColor.Primary : ButtonColor.Secondary;
    private ButtonColor CameraButtonColor => VoiceChatService.CameraEnabled ? ButtonColor.Primary : ButtonColor.Secondary;
    private ButtonColor ScreenShareButtonColor => VoiceChatService.ScreenShareEnabled ? ButtonColor.Primary : ButtonColor.Secondary;

    private IconName MicrophoneIconName => VoiceChatService.MicrophoneEnabled ? IconName.MicFill : IconName.MicMuteFill;
    private IconName CameraIconName => VoiceChatService.CameraEnabled ? IconName.CameraVideoFill : IconName.CameraVideoOffFill;
    private IconName ScreenShareIconName => VoiceChatService.ScreenShareEnabled ? IconName.DisplayFill : IconName.Display;

    private string MicrophoneTooltipText => VoiceChatService switch
    {
        { MicrophoneAvailable: false } => "Microphone is unavailable",
        { MicrophoneEnabled: false } => "Enable microphone",
        _ => "Disable microphone"
    };

    private string CameraTooltipText => VoiceChatService switch
    {
        { CameraAvailable: false } => "Camera is unavailable",
        { CameraEnabled: false } => "Enable camera",
        _ => "Disable camera"
    };

    private string ScreenShareTooltipText => VoiceChatService.ScreenShareEnabled ? "Stop screen share" : "Share your screen";

    private IconName ConnectionQualityIcon => VoiceChatService.ConnectionQuality switch
    {
        ConnectionQuality.Excellent => IconName.Wifi,
        ConnectionQuality.Good => IconName.Wifi2,
        ConnectionQuality.Poor => IconName.Wifi1,
        ConnectionQuality.Unknown => IconName.Broadcast,
        _ => IconName.WifiOff,
    };

    private IconColor ConnectionQualityColor => VoiceChatService.ConnectionQuality switch
    {
        ConnectionQuality.Excellent or ConnectionQuality.Good => IconColor.Success,
        ConnectionQuality.Poor => IconColor.Warning,
        ConnectionQuality.Unknown => IconColor.Primary,
        _ => IconColor.Danger,
    };

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += NavigationChanged;
        VoiceChatService.OnCurrentChannelCallChanged += StateHasChanged;
        VoiceChatService.LocalParticipantStateUpdated += StateHasChanged;
        ChatService.ChannelNameChanged += ChannelNameChanged;
    }

    private void ChannelNameChanged(GroupChatModel groupChat)
    {
        if (VoiceChatService.CallChannel == groupChat)
        {
            StateHasChanged();
        }
    }

    private Task GoToCallChannel()
    {
        return VoiceChatService.CallChannel is { } channel
            ? ChatService.OpenChannelAsync(channel)
            : Task.CompletedTask;
    }

    private void NavigationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    public void Dispose()
    {
        NavigationManager.LocationChanged -= NavigationChanged;
        VoiceChatService.OnCurrentChannelCallChanged -= StateHasChanged;
        VoiceChatService.LocalParticipantStateUpdated -= StateHasChanged;
        ChatService.ChannelNameChanged -= ChannelNameChanged;
    }
}
