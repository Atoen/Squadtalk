@using Shared.Results

<p class="mud-typography-body1 mud-typography-gutterbottom">
    @LocalizedText.R.add_friend
</p>

@if (_alertMessage is not null)
{
    <MudAlert Variant="Variant.Filled" Severity="_alertMessage.Severity"
              Class="mb-2" Dense="true">
        @_alertMessage.Text
    </MudAlert>
}

<form @onsubmit="SendFriendRequest" class="d-flex flex-grow-1">
    <MudTextField T="string" Label="@LocalizedText.R.username"
                  Clearable="true" @ref="_usernameField" autocomplete="off"/>
    <div class="align-self-center ms-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_working" ButtonType="ButtonType.Submit">
            @if (_working)
            {
                <MudProgressCircular Indeterminate="true"
                                     Color="Color.Default" Size="Size.Small"/>
            }
            else
            {
                @LocalizedText.R.send_friend_invite
            }
        </MudButton>
    </div>
</form>

@inject LocalizedText LocalizedText
@inject IContactManager ContactManager

@code
{
    private MudTextField<string> _usernameField = default!;

    private AlertMessage? _alertMessage;

    private bool _working;

    private async Task SendFriendRequest()
    {
        _alertMessage = null;

        if (_working || _usernameField is not { Value: { } username }) return;
        if (username.Length == 0) return;

        _working = true;

        var result = await ContactManager.SendFriendRequestAsync(username);

        _working = false;

        HandleResult(result);
    }

    private void HandleResult(FriendRequestResult? result)
    {
        _alertMessage = result switch
        {
            FriendRequestResult.Success => AlertMessage.Success(LocalizedText.R.friend_request_sent),
            FriendRequestResult.RecipientNotFound => AlertMessage.Info(LocalizedText.R.user_not_found),
            FriendRequestResult.RequestAlreadyPending => AlertMessage.Warning(LocalizedText.R.friend_request_already_pending),
            FriendRequestResult.SelfRequest => AlertMessage.Info(LocalizedText.R.cant_befriend_yourself),
            FriendRequestResult.AlreadyFriends => AlertMessage.Info(LocalizedText.R.user_is_already_friend),
            FriendRequestResult.Error => AlertMessage.Error(LocalizedText.R.server_error),
            null => AlertMessage.Error(LocalizedText.R.network_error),
            _ => _alertMessage
        };
    }
}