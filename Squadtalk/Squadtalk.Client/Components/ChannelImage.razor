@switch (Chat)
{
    case DirectMessageModel dm:
        @UserAvatar.PrimaryBadge((dm.Other.User, Size))
        break;

    case GroupChatModel { Others.Count: 0 }:
    {
        <MudAvatar Color="Color.Secondary" Size="Size">
            <MudIcon Icon="@Icons.Material.Rounded.Group" Size="Size"/>
        </MudAvatar>
        break;
    }

    case GroupChatModel { ImageUrl: { } url } groupChat:
    {
        <MudBadge Visible="groupChat.HasOnlineStatus" Color="Color.Success" Dot="Small">
            <MudAvatar Color="Color.Secondary" Size="Size">
                <MudImage Src="@url"/>
            </MudAvatar>
        </MudBadge>

        break;
    }

    case GroupChatModel groupChat:
    {
        <MudBadge Visible="groupChat.HasOnlineStatus" Color="Color.Success"
                  BadgeClass="primary-bordered z-10" Overlap="true">
            @{
                var containerClass = Small
                    ? "inline image-container"
                    : "image-container";

                var imageClass = Small
                    ? "inline group-avatar-item primary-bordered"
                    : "group-avatar-item primary-bordered";
            }

            <div class="@containerClass">

                @foreach (var user in groupChat.Others.Take(2))
                {
                    <img alt="@user.Username() Avatar" src="@user.AvatarUrl()"
                         class="@imageClass"/>
                }
            </div>
        </MudBadge>

        break;
    }
}

@code
{
    [Parameter, EditorRequired]
    public ChatModel Chat { get; set; } = default!;

    [Parameter]
    public bool Small { get; set; }

    private Size Size => Small ? Size.Small : Size.Medium;
}
