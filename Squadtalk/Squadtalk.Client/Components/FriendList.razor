@if (ContactManager.FriendList.Count == 0)
{
    <p class="mud-typography-body1">
        @LocalizedText.R.friend_list_empty
    </p>

    return;
}

<p class="mud-typography-body1 mud-typography-gutterbottom">
    @LocalizedText.R.all_friends - @ContactManager.FriendList.Count
</p>

@foreach (var friend in ContactManager.FriendList)
{
    <FriendTemplate @key="friend" Friend="friend"/>
}

@implements ISubscriber
@implements IDisposable

@inject LocalizedText LocalizedText
@inject IContactManager ContactManager
@inject IConnectionService ConnectionService
@inject IChatManager ChatManager
@inject ILogger<FriendList> Logger

@code
{
    private async Task MessageFriend(UserModel friend)
    {
        await ChatManager.OpenOrCreateTemporaryDirectMessageChannelAsync(friend);
    }

    private async Task StartVoiceCall(UserModel friend)
    {
        Logger.LogInformation("Staring voice call");
    }

    private async Task RemoveFriend(UserModel friend)
    {
        Logger.LogInformation("Removing friend");
        await ContactManager.RemoveFriendAsync(friend);
    }

    protected override Task OnInitializedAsync()
    {
        _subscription = ContactManager.FriendList.Subscribe(this);
        return RendererInfo.IsInteractive ? Task.CompletedTask : ConnectionService.ConnectAsync();
    }

    private IDisposable? _subscription;

    public void OnChange() => StateHasChanged();

    public void Dispose() => _subscription?.Dispose();
}
