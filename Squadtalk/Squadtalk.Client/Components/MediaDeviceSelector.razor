@if (Devices is { Length: > 0 })
{
    <Dropdown>
        <DropdownToggleButton Color="ButtonColor.Secondary">@ButtonText</DropdownToggleButton>
        <DropdownMenu>
            @foreach (var device in Devices)
            {
                <DropdownItem Type="ButtonType.Button" @onclick="() => SelectDevice(device)">
                    @if (device == _selected)
                    {
                        <div class="d-flex flex-row">
                            <div class="device-label">@device.Label</div>
                            <Icon Name="IconName.CheckLg" Color="IconColor.Success"/>
                        </div>
                    }
                    else
                    {
                        <div class="device-label">@device.Label</div>
                    }
                </DropdownItem>
            }
        </DropdownMenu>
    </Dropdown>
}
else
{
    @:No mics
}

@code {
    private MediaDeviceModel? _selected;

    [Parameter, EditorRequired] public MediaDeviceModel[]? Devices { get; set; }
    [Parameter, EditorRequired] public string ButtonText { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback<MediaDeviceModel> DeviceSelected { get; set; }

    private Task SelectDevice(MediaDeviceModel device)
    {
        if (device == _selected) return Task.CompletedTask;

        _selected = device;
        return DeviceSelected.InvokeAsync(device);
    }
}
