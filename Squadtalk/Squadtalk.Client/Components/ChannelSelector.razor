@using Shared.Communication
@using Squadtalk.Client.Extensions

<ConfirmDialog @ref="_dialog"/>
<Modal @ref="_createGroupModal" Size="ModalSize.Small" UseStaticBackdrop="true"/>

<div class="communication-tabs">
    <Button Color="ButtonColor.Primary" @onclick="DisplayGroupModal" TooltipTitle="Create new group chat">
        <Icon Name="IconName.PlusSquare" Size="IconSize.x5"/>
    </Button>

    <div class="global rounded" @onclick="() => ChatService.OpenChannelAsync(ChatService.GlobalChat)">
        <Icon Name="IconName.Globe2" Size="IconSize.x2"/>
        <span class>Global</span>

        @if (ChatService.CurrentChannel.IsGlobal() &&
             ChatService.GlobalChat.State is { UnreadMessages: > 0 and var unread } )
        {
            <Badge Color="BadgeColor.Danger"
                   Position="Position.Absolute"
                   Placement="BadgePlacement.TopRight"
                   IndicatorType="BadgeIndicatorType.RoundedPill"
                   VisuallyHiddenText="unread messages">
                @unread
            </Badge>
        }
    </div>

    @* @foreach (var groupChat in TabManager.VisibleGroupChats) *@
    @* { *@
    @*      *@
    @* } *@

    @foreach (var chat in ChatVisibilityManager.VisibleChannels)
    {
        <TextChatTemplate Model="chat as DirectMessageChannelModel" HideCallback="_confirmCallback" />
    }
</div>

@implements IDisposable
@inject IChatService ChatService
@inject IChatVisibilityManager ChatVisibilityManager
@inject ILogger<ChannelSelector> Logger

@code {

    private ConfirmDialog _dialog = default!;
    private EventCallback<DirectMessageChannelModel> _confirmCallback;

    private Modal _createGroupModal = default!;
    // private EventCallback _cancelCreateGroupCallback;
    // private EventCallback<UserModel> _createGroupCallback;
    private readonly Dictionary<string, object> _modalParameters = [];

    private readonly ConfirmDialogOptions _dialogOptions = new()
    {
        YesButtonText = "Yes",
        YesButtonColor = ButtonColor.Danger,
        NoButtonText = "Cancel",
        NoButtonColor = ButtonColor.Secondary
    };

    protected override void OnInitialized()
    {
        ChatService.StateChanged += StateHasChanged;
        ChatService.ChannelChanged += StateHasChanged;
        ChatVisibilityManager.StateChanged += StateHasChanged;

        _confirmCallback = EventCallback.Factory.Create<DirectMessageChannelModel>(this, ShowHidingConfirmationAsync);

        var hideModalCallback = EventCallback.Factory.Create(this, HideGroupModal);
        var createGroupCallback = EventCallback.Factory.Create<List<UserModel>>(this, CreateGroupChat);

        _modalParameters.Add(nameof(CreateGroupChatModal.CancelCallback), hideModalCallback);
        _modalParameters.Add(nameof(CreateGroupChatModal.CreateCallback), createGroupCallback);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        return firstRender ? ChatVisibilityManager.UpdateListAsync() : Task.CompletedTask;
    }

    private async Task ShowHidingConfirmationAsync(DirectMessageChannelModel directMessageChannelModel)
    {
        var confirmation = await _dialog.ShowAsync(
            title: "Hide Channel",
            message1: $"Hiding this text channel will make it inaccessible unless you send or receive messages from {directMessageChannelModel.Other.Username}.",
            message2: "Are you sure you want to proceed?",
            confirmDialogOptions: _dialogOptions);

        if (confirmation)
        {
            await ChatVisibilityManager.HideChannel(directMessageChannelModel.Id);
        }
    }

    public void Dispose()
    {
        ChatService.StateChanged -= StateHasChanged;
        ChatService.ChannelChanged -= StateHasChanged;
    }

    private Task DisplayGroupModal()
    {
        return _createGroupModal.ShowAsync<CreateGroupChatModal>("Select users to add", parameters: _modalParameters);
    }

    private Task HideGroupModal() => _createGroupModal.HideAsync();

    private async Task CreateGroupChat(List<UserModel> selectedUsers)
    {
        await _createGroupModal.HideAsync();
    }
}