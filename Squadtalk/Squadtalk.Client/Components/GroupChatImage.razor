@using Squadtalk.Client.Extensions
<div class="group-avatar-container">
    @if (GroupChat.ImageUrl is not null)
    {
        <img alt="@GroupChat.Name Image" src="@GroupChat.ImageUrl" class="image"/>
    }
    else
    {
        foreach (var user in GroupChat.Others.Take(2))
        {
            <img alt="@user.Username() Avatar" src="user.png" class="group-avatar-item"/>
        }
    }

    @if (GroupChat.Status != UserStatus.Offline)
    {
        <div class="online-indicator" style="@GetStyle"></div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public GroupChatModel GroupChat { get; set; } = default!;

    private string GetStyle => $"background-color: {GroupChat.Status.ColorStyle()}";
}
