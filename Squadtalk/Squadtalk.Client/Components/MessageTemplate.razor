@using Squadtalk.Client.Extensions

@if (Model.IsSystemMessage)
{
    <div class="system-message-container">
        <MessageEmbed Model="Model.Embed"/>
        <div class="date" data-date="@_longDate">@_date</div>
    </div>
}
else
{
    <div class="message-container rounded">
        @if (Model.IsSeparate)
        {
            <div class="padding"></div>
            <img class="avatar" src="@Model.Author.AvatarUrl" alt="Avatar" draggable="false"/>
            <div class="label">
                <div class="me-2">@Model.Author.Username</div>
                <div class="date" data-date="@_longDate">@_date</div>
            </div>
        }
        else
        {
            <div class="content-only-date">@_shortDate</div>
        }

        <div class="message-content">
            @if (Model.Embed is not null)
            {
                <MessageEmbed Model="Model.Embed"/>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Content))
            {
                <div style="white-space: pre-wrap">@Model.Content</div>
            }
        </div>
    </div>
}

@inject LocalizedText LocalizedText

@code
{
    [Parameter, EditorRequired]
    public required MessageModel Model { get; set; }

    private string? _date;
    private string? _longDate;
    private string? _shortDate;

    protected override void OnInitialized()
    {
        _date = Model.Timestamp.ToStringFormat(LocalizedText);
        _longDate = Model.Timestamp.ToStringFormat(LocalizedText, DateFormatMode.Long);
        _shortDate = Model.Timestamp.ToStringFormat(LocalizedText, DateFormatMode.Short);
    }

    protected override bool ShouldRender() => Model.ShouldRender();
}
