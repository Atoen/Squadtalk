@using Shared.Data.TypedIds

<div class="d-flex flex-column gap-2">
    <div class="d-flex flex-column align-items-center text-center">
        <ChannelImage Channel="CallChannel" DisplayStatus="false"/>
        <span>@CallChannel.Name</span>
    </div>

    <div class="d-flex gap-2 justify-content-center">
        <Button Color="ButtonColor.Danger" @onclick="DeclineCall">
            <Icon Name="IconName.TelephoneXFill" Size="IconSize.x4"/>
            @Table.DeclineCall
        </Button>
        <Button Color="ButtonColor.Success" @onclick="AcceptCall">
            <Icon Name="IconName.TelephoneFill" Size="IconSize.x4"/>
            @Table.AcceptCall
        </Button>
    </div>
</div>

@inherits LocalizedComponent

@code {

    [Parameter] public ChannelModel CallChannel { get; set; } = default!;
    [Parameter] public Func<bool, ChannelId, Task> DecisionCallback { get; set; } = default!;

    private Task AcceptCall()
    {
        return DecisionCallback.Invoke(true, CallChannel.Id);
    }

    private Task DeclineCall()
    {
        return DecisionCallback.Invoke(false, CallChannel.Id);
    }
}
