<MudDialog ContentClass="mt-n1" >
    <DialogContent>

        @if (_selectedUsers.Count != 0)
        {
            <div class="mt-n1 mb-1">
                @foreach (var selected in _selectedUsers)
                {
                    <div class="rounded pa-2 hover mud-chip-filled mud-chip"
                         @onclick="() => CloseChip(selected)">
                        @selected.User.Username

                        <MudIcon Size="Size.Small" Icon="@Icons.Material.Rounded.Close"/>
                    </div>
                }
            </div>
        }

        <MudTextField T="string" Immediate="true" @bind-Value="_searchValue"
                      Placeholder="@LocalizedText.R.enter_friend_username"/>

        <div class="my-1 overflow-y-auto" style="max-height: 200px">
            @if (!FilteredResults.Any())
            {
                <div class="mud-typography-body1 my-1">
                    @NotFoundText
                </div>
            }
            else
            {
                foreach (var result in FilteredResults.Take(10))
                {
                    @_listEntry(result)
                }
            }
        </div>

        <MudDivider/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnConfirm" Color="Color.Primary" FullWidth="true"
                   Variant="Variant.Filled" Disabled="DisableButton">
            @if (_working)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small"/>
            }
            else
            {
                @ConfirmButtonText
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@implements IDisposable

@inject LocalizedText LocalizedText
@inject IContactManager ContactManager
@inject IChatGroupManager ChatGroupManager

@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public FriendsSelectionType SelectionType { get; set; } = FriendsSelectionType.CreateGroup;

    [Parameter, EditorRequired]
    public EventCallback<List<UserModel>> OnSelection { get; set; }

    private string ConfirmButtonText => (SelectionType, _selectedUsers.Count) switch
    {
        (FriendsSelectionType.CreateGroup, 1) => LocalizedText.R.create_or_find_chat,
        (FriendsSelectionType.CreateGroup, _) => LocalizedText.R.create_new_group_chat,
        _ => LocalizedText.R.add
    };

    private string NotFoundText => SelectionType == FriendsSelectionType.CreateGroup
        ? LocalizedText.R.no_friends_found
        : LocalizedText.R.no_friends_found_not_present;

    private bool _working;
    private bool DisableButton => _working ||
        SelectionType == FriendsSelectionType.InviteToGroup && _selectedUsers.Count == 0;

    private string? _searchValue;

    private Func<SearchResult, bool> _searchFilter = default!;
    private IEnumerable<SearchResult> FilteredResults => _searchResults.Where(_searchFilter);

    private readonly List<SearchResult> _searchResults = [];
    private readonly List<SearchResult> _selectedUsers = [];

    // Not initializing here due to problem with source generator when using the SearchResult.Click
    private RenderFragment<SearchResult> _listEntry = default!;
    private RenderFragment<SearchResult> CreateRenderFragment() => searchResult =>
        @<div class="d-flex align-center my-1 pa-2 gap-2 hover rounded me-1 mud-ripple"
              @onclick="searchResult.Click">
            @UserAvatar.SurfaceBadgeMedium(searchResult.User)

            <div class="mud-typography-body1">
                @searchResult.User.Username
            </div>

            @{
                var (icon, color) = searchResult.IsSelected
                    ? (Icons.Material.Rounded.CheckBox, Color.Primary)
                    : (Icons.Material.Rounded.CheckBoxOutlineBlank, Color.Default);
            }

            <MudIcon Icon="@icon" Color="color" Class="ms-auto"/>
        </div>;

    protected override void OnInitialized()
    {
        _listEntry = CreateRenderFragment();

        if (SelectionType == FriendsSelectionType.CreateGroup)
        {
            _searchFilter = searchResult => string.IsNullOrWhiteSpace(_searchValue) ||
                              searchResult.User.Username.Contains(_searchValue, StringComparison.OrdinalIgnoreCase);
        }
        else if (ChatGroupManager.CurrentChannel is { } channel)
        {
            _searchFilter = searchResult =>
                !channel.Others.Select(x => x.User).Contains(searchResult.User) &&
                (string.IsNullOrWhiteSpace(_searchValue) || searchResult.User.Username.Contains(_searchValue, StringComparison.OrdinalIgnoreCase));
        }

        var onClick = ClickResult;
        var results = ContactManager.FriendList
            .Select(x => new SearchResult(x, onClick));

        _searchResults.AddRange(results);

        ContactManager.FriendListChanged += FriendListChanged;
    }

    private void FriendListChanged()
    {
        var countBefore = _searchResults.Count;

        var onClick = ClickResult;
        var results = ContactManager.FriendList
            .Select(x => new SearchResult(x, onClick));

        _searchResults.Clear();
        _searchResults.AddRange(results);

        // There are fewer friends than when we stared - remove possible selection of removed friend
        if (countBefore > ContactManager.FriendList.Count)
        {
            _selectedUsers.RemoveAll(x => !ContactManager.FriendList.Contains(x.User));
        }

        StateHasChanged();
    }

    private async Task OnConfirm()
    {
        if (!OnSelection.HasDelegate)
        {
            return;
        }

        _working = true;

        var users = _selectedUsers.Select(x => x.User).ToList();
        await OnSelection.InvokeAsync(users);

        _working = false;
    }

    // private async Task AddFriendsToGroupAsync()
    // {
    //     if (_selectedUsers.Count == 0) return;
    //
    //     var selectedFriends = _selectedUsers.Select(x => x.User);
    //     await ChannelManager.AddFriendsToGroupAsync(selectedFriends);
    // }

    private void CloseChip(SearchResult searchResult)
    {
        _selectedUsers.Remove(searchResult);
        searchResult.IsSelected = false;
    }

    private void ClickResult(SearchResult searchResult)
    {
        if (searchResult.IsSelected)
        {
            _selectedUsers.Add(searchResult);
            _searchValue = null;
        }
        else
        {
            _selectedUsers.Remove(searchResult);
        }
    }

    private class SearchResult(UserModel user, Action<SearchResult> onClick)
    {
        public UserModel User { get; } = user;
        public bool IsSelected { get; set; }

        private Action? _click;
        public Action Click => _click ??= () =>
        {
            IsSelected = !IsSelected;
            onClick(this);
        };
    }

    public void Dispose()
    {
        ContactManager.FriendListChanged -= FriendListChanged;
    }

    public enum FriendsSelectionType
    {
        CreateGroup,
        InviteToGroup
    }
}
