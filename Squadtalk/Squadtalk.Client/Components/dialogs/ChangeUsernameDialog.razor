@using Shared.Data.Results
@using Shared.DTOs.Account
@using Color = MudBlazor.Color

<MudDialog>
    <DialogContent>

        @if (_alertMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="_alertMessage.Severity" Class="mb-2" Dense="true">
                @_alertMessage.Text
            </MudAlert>
        }

        @LocalizedText.R.enter_new_username_and_password

        <MudForm @ref="_form" Spacing="2">
            <MudTextField T="string" Label="@LocalizedText.R.username" Required="true"
                          @ref="_usernameField" Counter="@IFormValidator.MaximumUsernameLength" Immediate="true"
                          Validation="FormValidator.UsernameValidator"
                          RequiredError="@LocalizedText.R.username_is_required"
                          Error="UsernameError" ErrorText="@UsernameErrorText"/>

            <MudTextField T="string" Label="@LocalizedText.R.current_password" Required="true"
                          @ref="_passwordField" InputType="InputType.Password"
                          RequiredError="@LocalizedText.R.password_is_required"
                          Error="PasswordError" ErrorText="@PasswordErrorText"/>

            <AntiforgeryToken/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">
            @LocalizedText.R.dialog_cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_working" OnClick="ChangeUsername">
            @if (_working)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Default" Size="Size.Small"/>
            }
            else
            {
                @LocalizedText.R.dialog_done
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@inject LocalizedText LocalizedText
@inject IUserAuthenticationService UserAuthenticationService
@inject IAccountManager AccountManager
@inject ILogger<ChangeUsernameDialog> Logger
@inject IFormValidator FormValidator

@code
{
    private MudForm _form = default!;
    private MudTextField<string>? _usernameField;
    private MudTextField<string>? _passwordField;

    private AlertMessage? _alertMessage;

    private string? _serverUsernameError;
    private string? _serverPasswordError;

    private bool UsernameError => _serverUsernameError is not null || _usernameField?.Error == true;
    private bool PasswordError => _serverPasswordError is not null || _passwordField?.Error == true;

    private string? UsernameErrorText => _serverUsernameError ?? _usernameField?.ErrorText;
    private string? PasswordErrorText => _serverPasswordError ?? _passwordField?.ErrorText;

    private bool _working;

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private async Task ChangeUsername()
    {
        _alertMessage = null;
        _serverUsernameError = null;
        _serverPasswordError = null;

        await _form.Validate();

        if (!_form.IsValid || _working) return;

        var username = _usernameField?.Value!;

        if (username == UserAuthenticationService.Username)
        {
            _alertMessage = AlertMessage.Success(LocalizedText.R.username_not_changed);
            return;
        }

        _working = true;

        var data = new ChangeUsernameDto
        {
            UserId = UserAuthenticationService.UserId.ToString(),
            NewUsername = username,
            Password = _passwordField?.Value!
        };

        var result = await AccountManager.ChangeUsernameAsync(data);

        _working = false;

        HandleResult(result);
    }

    private void HandleResult(ChangeUsernameResult result)
    {
        switch (result)
        {
            case ChangeUsernameResult.Success success:
                Logger.LogInformation("Changed username to {Username}", success.NewUsername);
                _alertMessage = AlertMessage.Success(LocalizedText.R.username_changed);
                break;

            case ChangeUsernameResult.NotChanged:
                _alertMessage = AlertMessage.Info(LocalizedText.R.username_not_changed);
                break;

            case ChangeUsernameResult.NotFound:
                _alertMessage = AlertMessage.Error(LocalizedText.R.failed_to_change_username);
                break;

            case ChangeUsernameResult.Unauthorized:
                _serverPasswordError = LocalizedText.R.invalid_password;
                break;

            case ChangeUsernameResult.UsernameInUse:
                _serverUsernameError = LocalizedText.R.this_username_in_use;
                break;

            case ChangeUsernameResult.FailedToChange:
                _alertMessage = AlertMessage.Error(LocalizedText.R.failed_to_change_username);
                break;

            case ChangeUsernameResult.NetworkError:
                _alertMessage = AlertMessage.Error(LocalizedText.R.network_error);
                break;
        }
    }
}