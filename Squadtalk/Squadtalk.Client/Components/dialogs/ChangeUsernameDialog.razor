@using Shared.Data.Results
@using Shared.DTOs.Account
@using Squadtalk.Client.Services
@using Color = MudBlazor.Color

<MudDialog>
    <DialogContent>

        @if (_successMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Success" Class="mb-2" Dense="true">
                @_successMessage
            </MudAlert>
        }
        else if (_errorMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Error" Class="mb-2" Dense="true">
                @_errorMessage
            </MudAlert>
        }

        @LocalizedText.R.enter_new_username_and_password

        <MudForm @ref="_form" Spacing="2">
            <MudTextField T="string" Label="@LocalizedText.R.username" Required="true"
                          @ref="_usernameField" Counter="@FormValidator.MaximumUsernameLength" Immediate="true"
                          Validation="FormValidator.UsernameValidator"
                          Error="@(_usernameError is not null)" ErrorText="@_usernameError"/>

            <MudTextField T="string" Label="@LocalizedText.R.current_password" Required="true"
                          @ref="_passwordField" InputType="InputType.Password"
                          Error="@(_passwordError is not null)" ErrorText="@_passwordError"/>

            <AntiforgeryToken/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">
            @LocalizedText.R.dialog_cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_working" OnClick="ChangeUsername">
            @if (_working)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Default" Size="Size.Small"/>
            }
            else
            {
                @LocalizedText.R.dialog_done
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@inject LocalizedText LocalizedText
@inject IUserAuthenticationService UserAuthenticationService
@inject IAccountManager AccountManager
@inject ILogger<ChangeUsernameDialog> Logger
@inject FormValidator FormValidator

@code
{
    private MudForm _form = default!;
    private MudTextField<string> _usernameField = default!;
    private MudTextField<string> _passwordField = default!;

    private string? _successMessage;
    private string? _errorMessage;

    private string? _usernameError;
    private string? _passwordError;

    private bool _working;

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private async Task ChangeUsername()
    {
        _successMessage = null;
        _errorMessage = null;

        if (!_form.IsValid || _working) return;

        _working = true;
        _usernameError = null;
        _passwordError = null;

        var username = _usernameField.Value!;

        if (username == UserAuthenticationService.Username)
        {
            _successMessage = LocalizedText.R.username_not_changed;
            return;
        }

        var data = new ChangeUsernameDto
        {
            UserId = UserAuthenticationService.UserId.ToString(),
            NewUsername = username,
            Password = _passwordField.Value!
        };

        var result = await AccountManager.ChangeUsernameAsync(data);

        _working = false;

        HandleResult(result);
    }

    private void HandleResult(ChangeUsernameResult result)
    {
        switch (result)
        {
            case ChangeUsernameResult.Success success:
                Logger.LogInformation("Changed username to {Username}", success.NewUsername);
                _successMessage = LocalizedText.R.username_changed;
                break;

            case ChangeUsernameResult.NotChanged:
                _successMessage = LocalizedText.R.username_not_changed;
                break;

            case ChangeUsernameResult.NotFound:
                _errorMessage = LocalizedText.R.failed_to_change_username;
                break;

            case ChangeUsernameResult.Unauthorized:
                _passwordError = LocalizedText.R.invalid_password;
                break;

            case ChangeUsernameResult.UsernameInUse:
                _usernameError = LocalizedText.R.this_username_in_use;
                break;

            case ChangeUsernameResult.FailedToChange:
                _errorMessage = LocalizedText.R.failed_to_change_username;
                break;

            case ChangeUsernameResult.NetworkError:
                _errorMessage = LocalizedText.R.network_error;
                break;
        }
    }
}