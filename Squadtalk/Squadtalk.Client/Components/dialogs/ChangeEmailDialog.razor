@using System.Net
@using RestSharp
@using Shared.DTOs.Account
@using Shared.Extensions
@using Shared.Routing
@using Color = MudBlazor.Color

<MudDialog>
    <DialogContent>

        @if (_successMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Success" Class="mb-2" Dense="true">
                @_successMessage
            </MudAlert>
        }
        else if (_errorMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Error" Class="mb-2" Dense="true">
                @_errorMessage
            </MudAlert>
        }

        @LocalizedText.R.enter_new_email_and_password

        <MudForm @ref="_form" @bind-IsValid="_formValid" Spacing="2">
            <MudTextField T="string" Label="@LocalizedText.R.email" Required="true"
                          @ref="_emailField" InputMode="InputMode.email"/>

            <MudTextField T="string" Label="@LocalizedText.R.current_password" Required="true"
                          @ref="_passwordField" InputType="InputType.Password"/>

            <AntiforgeryToken/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">
            @LocalizedText.R.dialog_cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChangeEmail">
            @LocalizedText.R.dialog_done
        </MudButton>
    </DialogActions>
</MudDialog>

@inject LocalizedText LocalizedText
@inject ISnackbar Snackbar
@inject IUserAuthenticationService UserAuthenticationService
@inject RestClient RestClient

@code
{
    private MudForm _form = default!;
    private MudTextField<string> _emailField = default!;
    private MudTextField<string> _passwordField = default!;

    private string? _successMessage;
    private string? _errorMessage;

    private bool _formValid;

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private async Task ChangeEmail()
    {
        if (!_form.IsValid) return;

        var email = _emailField.Value!;

        var request = new RestRequest(Routes.Endpoints.ChangeEmail)
            .AddBody(new ChangeEmailDto
            {
                UserId = UserAuthenticationService.UserId.ToString(),
                NewEmail = email,
                Password = _passwordField.Value!
            });

        try
        {
            _successMessage = null;
            _errorMessage = null;

            var response = await RestClient.PostAsync(request);

            switch (response.StatusCode)
            {
                case HttpStatusCode.OK:
                    _successMessage = LocalizedText.R.email_change_confirmation_sent;
                    break;

                case HttpStatusCode.NoContent:
                    _successMessage = LocalizedText.R.email_not_changed;
                    break;

                case HttpStatusCode.Conflict:
                    _errorMessage = LocalizedText.R.email_in_use_template.Format(email);
                    break;

                case HttpStatusCode.Unauthorized:
                    _errorMessage = LocalizedText.R.invalid_password;
                    break;

                default:
                    _errorMessage = LocalizedText.R.failed_to_change_email_code_template.Format((int) response.StatusCode);
                    break;
            }
        }
        catch
        {
            _errorMessage = LocalizedText.R.failed_to_change_email;
            Snackbar.Add(LocalizedText.R.failed_to_change_email, Severity.Error);
        }
    }
}