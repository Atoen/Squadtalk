@using Shared.Data.Results
@using Shared.DTOs.Account
@using Shared.Extensions
@using Color = MudBlazor.Color

<MudDialog>
    <DialogContent>

        @if (_successMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Success" Class="mb-2" Dense="true">
                @_successMessage
            </MudAlert>
        }
        else if (_errorMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Error" Class="mb-2" Dense="true">
                @_errorMessage
            </MudAlert>
        }

        @LocalizedText.R.enter_new_email_and_password

        <MudForm @ref="_form" Spacing="2">
            <MudTextField T="string" Label="@LocalizedText.R.email" Required="true"
                          @ref="_emailField" InputMode="InputMode.email" Immediate="true"/>

            <MudTextField T="string" Label="@LocalizedText.R.current_password" Required="true"
                          @ref="_passwordField" InputType="InputType.Password"/>

            <AntiforgeryToken/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">
            @LocalizedText.R.dialog_cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_working" OnClick="ChangeEmail">
            @LocalizedText.R.dialog_done
        </MudButton>
    </DialogActions>
</MudDialog>

@inject LocalizedText LocalizedText
@inject IUserAuthenticationService UserAuthenticationService
@inject IAccountManager AccountManager

@code
{
    private MudForm _form = default!;
    private MudTextField<string> _emailField = default!;
    private MudTextField<string> _passwordField = default!;

    private string? _successMessage;
    private string? _errorMessage;

    private bool _working;

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private async Task ChangeEmail()
    {
        _successMessage = null;
        _errorMessage = null;

        if (!_form.IsValid || _working) return;

        _working = true;
        _emailField.Error = false;
        _passwordField.Error = false;

        var email = _emailField.Value!;

        var data = new ChangeEmailDto
        {
            UserId = UserAuthenticationService.UserId.ToString(),
            NewEmail = email,
            Password = _passwordField.Value!
        };

        var result = await AccountManager.ChangeEmailAsync(data);

        _working = false;

        HandleResult(result);
    }

    private void HandleResult(ChangeEmailResult result)
    {
        switch (result)
        {
            case ChangeEmailResult.ConfirmationSent:
                _successMessage = LocalizedText.R.email_change_confirmation_sent;
                break;

            case ChangeEmailResult.NotChanged:
                _successMessage = LocalizedText.R.email_not_changed;
                break;

            case ChangeEmailResult.EmailInUse:
                _emailField.Error = true;
                _emailField.ErrorText = LocalizedText.R.this_email_in_use;
                break;

            case ChangeEmailResult.Unauthorized:
                _passwordField.Error = true;
                _passwordField.ErrorText = LocalizedText.R.invalid_password;
                _errorMessage = LocalizedText.R.invalid_password;
                break;

            case ChangeEmailResult.NotFound:
            case ChangeEmailResult.FailedToChange:
                _errorMessage = LocalizedText.R.failed_to_change_email;
                break;

            case ChangeEmailResult.NetworkError:
                _errorMessage = LocalizedText.R.network_error;
                break;
        }
    }
}