@using Shared.Data.Results
@using Shared.DTOs.Account
@using Color = MudBlazor.Color

<MudDialog>
    <DialogContent>

        @if (_alertMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="_alertMessage.Severity" Class="mb-2" Dense="true">
                @_alertMessage.Text
            </MudAlert>
        }

        @LocalizedText.R.enter_new_email_and_password

        <MudForm @ref="_form" Spacing="2">
            <MudTextField T="string" Label="@LocalizedText.R.email" Required="true"
                          RequiredError="@LocalizedText.R.email_is_required"
                          @ref="_emailField" InputMode="InputMode.email" Immediate="true"
                          Validation="FormValidator.EmailValidator"
                          Error="EmailError" ErrorText="@EmailErrorText"/>

            <MudTextField T="string" Label="@LocalizedText.R.current_password" Required="true"
                          RequiredError="@LocalizedText.R.password_is_required"
                          @ref="_passwordField" InputType="InputType.Password"
                          Error="PasswordError" ErrorText="@PasswordErrorText"/>

            <AntiforgeryToken/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">
            @LocalizedText.R.dialog_cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_working" OnClick="ChangeEmail">
            @if (_working)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Default" Size="Size.Small"/>
            }
            else
            {
                @LocalizedText.R.dialog_done
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@inject LocalizedText LocalizedText
@inject IUserAuthenticationService UserAuthenticationService
@inject IAccountManager AccountManager
@inject IFormValidator FormValidator

@code
{
    private MudForm _form = default!;
    private MudTextField<string>? _emailField;
    private MudTextField<string>? _passwordField;

    private AlertMessage? _alertMessage;

    private string? _serverEmailError;
    private string? _serverPasswordError;

    private bool EmailError => _serverEmailError is not null || _emailField?.Error == true;
    private bool PasswordError => _serverPasswordError is not null || _passwordField?.Error == true;

    private string? EmailErrorText => _serverEmailError ?? _emailField?.ErrorText;
    private string? PasswordErrorText => _serverPasswordError ?? _passwordField?.ErrorText;

    private bool _working;

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private async Task ChangeEmail()
    {
        _alertMessage = null;
        _serverEmailError = null;
        _serverPasswordError = null;

        await _form.Validate();

        if (!_form.IsValid || _working) return;

        _working = true;

        var data = new ChangeEmailDto
        {
            UserId = UserAuthenticationService.UserId.ToString(),
            NewEmail = _emailField?.Value!,
            Password = _passwordField?.Value!
        };

        var result = await AccountManager.ChangeEmailAsync(data);

        _working = false;

        HandleResult(result);
    }

    private void HandleResult(ChangeEmailResult result)
    {
        switch (result)
        {
            case ChangeEmailResult.ConfirmationSent:
                _alertMessage = AlertMessage.Success(LocalizedText.R.email_change_confirmation_sent);
                break;

            case ChangeEmailResult.NotChanged:
                _alertMessage = AlertMessage.Info(LocalizedText.R.email_not_changed);
                break;

            case ChangeEmailResult.EmailInUse:
                _serverEmailError = LocalizedText.R.this_email_in_use;
                break;

            case ChangeEmailResult.Unauthorized:
                _serverPasswordError = LocalizedText.R.invalid_password;
                break;

            case ChangeEmailResult.NotFound:
            case ChangeEmailResult.FailedToChange:
                _alertMessage = AlertMessage.Error(LocalizedText.R.failed_to_change_email);
                break;

            case ChangeEmailResult.NetworkError:
                _alertMessage = AlertMessage.Error(LocalizedText.R.network_error);
                break;
        }
    }
}