@using Shared.Data.Results
@using Shared.DTOs.Account
@using Color = MudBlazor.Color

<MudDialog>
    <DialogContent>

        @if (_alertMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="_alertMessage.Severity" Class="mb-2" Dense="true">
                @_alertMessage.Text
            </MudAlert>
        }

        @LocalizedText.R.enter_current_and_new_password

        <MudForm @ref="_form" Spacing="2">

            <MudTextField T="string" Label="@LocalizedText.R.current_password" Required="true"
                          RequiredError="@LocalizedText.R.password_is_required"
                          InputType="InputType.Password" @ref="_currentPasswordField" Immediate="true"
                          Error="PasswordError" ErrorText="@PasswordErrorText"/>

            <MudTextField T="string" Label="@LocalizedText.R.new_password" Required="true"
                          RequiredError="@LocalizedText.R.new_password_required"
                          InputType="InputType.Password" @ref="_newPasswordFieldField" Immediate="true"
                          Validation="@FormValidator.PasswordValidator"/>

            <MudTextField T="string" Label="@LocalizedText.R.confirm_password" Required="true" Immediate="true"
                          RequiredError="@LocalizedText.R.new_password_confirmation_required"
                          InputType="InputType.Password"
                          Validation="@(new Func<string, string?>(PasswordMatch))"/>
        </MudForm>

    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">
            @LocalizedText.R.dialog_cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_working" OnClick="ChangePassword">
            @if (_working)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Default" Size="Size.Small"/>
            }
            else
            {
                @LocalizedText.R.dialog_done
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@inject LocalizedText LocalizedText
@inject IUserAuthenticationService UserAuthenticationService
@inject IAccountManager AccountManager
@inject IFormValidator FormValidator

@code
{
    private MudForm _form = default!;
    private MudTextField<string>? _currentPasswordField;
    private MudTextField<string>? _newPasswordFieldField;

    private AlertMessage? _alertMessage;

    private string? _serverPasswordError;

    private bool PasswordError => _serverPasswordError is not null || _currentPasswordField?.Error == true;
    private string? PasswordErrorText => _serverPasswordError ?? _currentPasswordField?.ErrorText;

    private bool _working;

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private async Task ChangePassword()
    {
        _alertMessage = null;
        _serverPasswordError = null;

        await _form.Validate();

        if (!_form.IsValid || _working) return;

        _working = true;

        var data = new ChangePasswordDto
        {
            UserId = UserAuthenticationService.UserId.ToString(),
            CurrentPassword = _currentPasswordField?.Value!,
            NewPassword = _newPasswordFieldField?.Value!
        };

        var result = await AccountManager.ChangePasswordAsync(data);

        _working = false;

        switch (result)
        {
            case ChangePasswordResult.Success:
                _alertMessage = AlertMessage.Success(LocalizedText.R.password_changed);
                break;

            case ChangePasswordResult.Fail:
                _serverPasswordError = LocalizedText.R.invalid_password;
                break;

            case ChangePasswordResult.NetworkError:
                _alertMessage = AlertMessage.Error(LocalizedText.R.network_error);
                break;
        }
    }

    private string? PasswordMatch(string arg)
    {
        return FormValidator.PasswordMatches(_newPasswordFieldField?.Value, arg);
    }
}