@using System.Net
@using System.Text.RegularExpressions
@using RestSharp
@using Shared
@using Shared.DTOs.Account
@using Color = MudBlazor.Color

<MudDialog>
    <DialogContent>
        @if (_successMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Success" Class="mb-2" Dense="true">
                @_successMessage
            </MudAlert>
        }
        else if (_errorMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Error" Class="mb-2" Dense="true">
                @_errorMessage
            </MudAlert>
        }

        @LocalizedText.R.enter_current_and_new_password

        <MudForm @ref="_form" @bind-IsValid="_formValid" Spacing="2">

            <MudTextField T="string" Label="@LocalizedText.R.current_password" Required="true"
                          InputType="InputType.Password" @ref="_currentPasswordField"/>

            <MudTextField T="string" Label="@LocalizedText.R.new_password" Required="true"
                          InputType="InputType.Password" @ref="_newPasswordFieldField"
                          Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))"/>

            <MudTextField T="string" Label="@LocalizedText.R.password" Required="true"
                          HelperText="@LocalizedText.R.confirm_password" InputType="InputType.Password"
                          Validation="@(new Func<string, string?>(PasswordMatch))"/>
        </MudForm>

    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">
            @LocalizedText.R.dialog_cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChangePassword">
            @LocalizedText.R.dialog_done
        </MudButton>
    </DialogActions>
</MudDialog>

@inject LocalizedText LocalizedText
@inject ISnackbar Snackbar
@inject IUserAuthenticationService UserAuthenticationService
@inject RestClient RestClient

@code
{
    private MudForm _form = default!;

    private MudTextField<string> _currentPasswordField = default!;
    private MudTextField<string> _newPasswordFieldField = default!;

    private string? _successMessage;
    private string? _errorMessage;

    private bool _formValid;

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private async Task ChangePassword()
    {
        if (!_form.IsValid) return;

        var request = new RestRequest(Endpoints.ChangePassword)
            .AddBody(new ChangePasswordDto
            {
                UserId = UserAuthenticationService.UserId.ToString(),
                CurrentPassword = _currentPasswordField.Value!,
                NewPassword = _newPasswordFieldField.Value!
            });

        try
        {
            _successMessage = null;
            _errorMessage = null;

            var response = await RestClient.PostAsync(request);
            switch (response.StatusCode)
            {
                case HttpStatusCode.OK:
                    _successMessage = LocalizedText.R.password_changed;
                    break;
                case HttpStatusCode.Unauthorized:
                    _errorMessage = LocalizedText.R.invalid_password;
                    break;
                default:
                    _errorMessage = LocalizedText.R.failed_to_change_password;
                    break;
            }
        }
        catch
        {
            _errorMessage = LocalizedText.R.failed_to_change_password;
            Snackbar.Add(LocalizedText.R.failed_to_change_email, Severity.Error);
        }
    }

    private IEnumerable<string> PasswordStrength(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
        {
            yield return LocalizedText.R.password_is_required;
            yield break;
        }

        if (password.Length < 8)
        {
            yield return LocalizedText.R.password_length;
        }
        if (!Regex.IsMatch(password, "[A-Z]"))
        {
            yield return LocalizedText.R.password_uppercase;
        }
        if (!Regex.IsMatch(password, "[a-z]"))
        {
            yield return LocalizedText.R.password_lowercase;
        }
        if (!Regex.IsMatch(password, "[0-9]"))
        {
            yield return LocalizedText.R.password_digit;
        }
    }

    private string? PasswordMatch(string arg)
    {
        return _newPasswordFieldField.Value != arg ? LocalizedText.R.passwords_dont_match : null;
    }
}