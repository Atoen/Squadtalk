@using Shared.Data.Results
@using Shared.DTOs.Account
@using Squadtalk.Client.Services
@using Color = MudBlazor.Color

<MudDialog>
    <DialogContent>
        @if (_successMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Success" Class="mb-2" Dense="true">
                @_successMessage
            </MudAlert>
        }
        else if (_errorMessage is not null)
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Error" Class="mb-2" Dense="true">
                @_errorMessage
            </MudAlert>
        }

        @LocalizedText.R.enter_current_and_new_password

        <MudForm @ref="_form" Spacing="2">

            <MudTextField T="string" Label="@LocalizedText.R.current_password" Required="true"
                          InputType="InputType.Password" @ref="_currentPasswordField" Immediate="true"/>

            <MudTextField T="string" Label="@LocalizedText.R.new_password" Required="true"
                          InputType="InputType.Password" @ref="_newPasswordFieldField" Immediate="true"
                          Validation="@PasswordValidator.StrengthValidator"/>

            <MudTextField T="string" Label="@LocalizedText.R.password" Required="true" Immediate="true"
                          HelperText="@LocalizedText.R.confirm_password" InputType="InputType.Password"
                          Validation="@(new Func<string, string?>(PasswordMatch))"/>
        </MudForm>

    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">
            @LocalizedText.R.dialog_cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_working" OnClick="ChangePassword">
            @LocalizedText.R.dialog_done
        </MudButton>
    </DialogActions>
</MudDialog>

@inject LocalizedText LocalizedText
@inject IUserAuthenticationService UserAuthenticationService
@inject IAccountManager AccountManager
@inject PasswordValidator PasswordValidator

@code
{
    private MudForm _form = default!;

    private MudTextField<string> _currentPasswordField = default!;
    private MudTextField<string> _newPasswordFieldField = default!;

    private string? _successMessage;
    private string? _errorMessage;

    private bool _working;

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private async Task ChangePassword()
    {
        _successMessage = null;
        _errorMessage = null;

        if (!_form.IsValid || _working) return;

        _working = true;
        _currentPasswordField.Error = false;
        _newPasswordFieldField.Error = false;

        var data = new ChangePasswordDto
        {
            UserId = UserAuthenticationService.UserId.ToString(),
            CurrentPassword = _currentPasswordField.Value!,
            NewPassword = _newPasswordFieldField.Value!
        };

        var result = await AccountManager.ChangePasswordAsync(data);

        _working = false;

        switch (result)
        {
            case ChangePasswordResult.Success:
                _successMessage = LocalizedText.R.password_changed;
                break;

            case ChangePasswordResult.Fail:
                _currentPasswordField.Error = true;
                _currentPasswordField.ErrorText = LocalizedText.R.invalid_password;
                break;

            case ChangePasswordResult.NetworkError:
                _errorMessage = LocalizedText.R.network_error;
                break;
        }
    }

    private string? PasswordMatch(string arg)
    {
        return _newPasswordFieldField.Value != arg ? LocalizedText.R.passwords_dont_match : null;
    }
}