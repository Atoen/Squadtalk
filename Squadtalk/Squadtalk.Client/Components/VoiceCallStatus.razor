    private void VoiceChatServiceCallEnded(ChatModel chat)
    {
        if (VoiceChatService.CurrentChannel == chat)
        {
            StateHasChanged();
        }
    }

    private void ParticipantListUpdated(ChatModel chat)
    {
        if (VoiceChatService.CurrentChannel == chat)
        {
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        VoiceChatService.CallEnded -= VoiceChatServiceCallEnded;
        VoiceChatService.Disconnected -= VoiceChatServiceDisconnected;
        VoiceChatService.Error -= VoiceChatServiceError;
        VoiceChatService.ParticipantListUpdated -= ParticipantListUpdated;
        VoiceChatService.CurrentChannelCallChanged -= StateHasChanged;
        ChatGroupManager.ChannelChanged -= StateHasChanged;
