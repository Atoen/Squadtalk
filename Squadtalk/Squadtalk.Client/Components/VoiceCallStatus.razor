<div class="call-container rounded">
    <div class="video-container my-2" id="maximized-video-container" @onclick="MinimizeVideo">
        <video class="video-frame" id="maximized-video" autoplay></video>
    </div>

    @if (VoiceChatService.ConnectedToVoiceCallOnCurrentChannel)
    {
        <div class="participants">
            @foreach (var participant in VoiceChatService.ActiveCallParticipants.OrderBy(x => x.Username))
            {
                <CallParticipant Model="participant"/>
            }
        </div>

    }
    else if (VoiceChatService.ActiveCallOnCurrentChannel)
    {
        <div>Join voice call: @VoiceChatService.CurrentChannel?.Name</div>
    }

    @if (ShowControls)
    {
        <VoiceCallControls/>
    }
</div>

@implements IDisposable

@inject IChatService ChatService
@inject IVoiceChatService VoiceChatService
@inject ILogger<VoiceCallStatus> Logger
@inject ToastService ToastService

@code {

    private bool ShowControls => VoiceChatService.ConnectedToVoiceCallOnCurrentChannel
                                 || VoiceChatService.ActiveCallOnCurrentChannel;

    private Task MinimizeVideo() => VoiceChatService.MinimizeVideoAsync();

    protected override void OnInitialized()
    {
        VoiceChatService.OnCallEnded += VoiceChatServiceOnOnCallEnded;
        VoiceChatService.OnDisconnected += VoiceChatServiceOnOnDisconnected;
        VoiceChatService.OnError += VoiceChatServiceOnOnError;
        VoiceChatService.OnParticipantsUpdated += VoiceChatServiceOnOnParticipantsUpdated;
        VoiceChatService.OnCurrentChannelCallChanged += StateHasChanged;
        ChatService.ChannelChanged += StateHasChanged;
    }

    private void VoiceChatServiceOnOnError(string title, string message)
    {
        var toast = new ToastMessage
        {
            Type = ToastType.Danger,
            Title = title,
            Message = message,
            AutoHide = false,
            IconName = IconName.Exclamation
        };

        ToastService.Notify(toast);
    }

    private void VoiceChatServiceOnOnDisconnected(DisconnectReason reason)
    {
        if (reason == DisconnectReason.ClientInitiated) return;

        var toast = new ToastMessage
        {
            Type = ToastType.Warning,
            Title = "Disconnected from channel",
            Message = $"Disconnect reason: {reason}",
            AutoHide = false,
            IconName = IconName.Exclamation
        };

        ToastService.Notify(toast);
    }

    private void VoiceChatServiceOnOnCallEnded(ChannelModel channel)
    {
        if (VoiceChatService.CurrentChannel == channel)
        {
            StateHasChanged();
        }
    }

    private void VoiceChatServiceOnOnParticipantsUpdated(ChannelModel channel)
    {
        if (VoiceChatService.CurrentChannel == channel)
        {
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        VoiceChatService.OnCallEnded -= VoiceChatServiceOnOnCallEnded;
        VoiceChatService.OnDisconnected -= VoiceChatServiceOnOnDisconnected;
        VoiceChatService.OnError -= VoiceChatServiceOnOnError;
        VoiceChatService.OnParticipantsUpdated -= VoiceChatServiceOnOnParticipantsUpdated;
        VoiceChatService.OnCurrentChannelCallChanged -= StateHasChanged;
        ChatService.ChannelChanged -= StateHasChanged;
    }
}
