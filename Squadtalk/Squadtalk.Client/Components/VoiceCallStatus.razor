@implements IDisposable

<div class="video-container my-2" id="maximized-video-container" @onclick="MinimizeVideo">
    <video class="video-frame" id="maximized-video" autoplay></video>
</div>

@if (VoiceChatService.JoinedRoom)
{
    <div class="participants">
        @foreach (var participant in VoiceChatService.Participants)
        {
            <CallParticipant Model="participant"/>
        }
    </div>

    <MediaDevicesStatus/>
}

@inject IVoiceChatService VoiceChatService

@code {

    private Task MinimizeVideo() => VoiceChatService.MinimizeVideoAsync();

    protected override void OnInitialized()
    {
        VoiceChatService.OnParticipantUpdated += ParticipantUpdated;
        VoiceChatService.OnConnected += StateHasChanged;
        VoiceChatService.OnDisconnected += Disconnected;
        VoiceChatService.OnParticipantConnected += ParticipantUpdated;
        VoiceChatService.OnParticipantDisconnected += ParticipantUpdated;
    }

    private void Disconnected(DisconnectReason _) => StateHasChanged();

    private void ParticipantUpdated(CallParticipantModel _) => StateHasChanged();

    public void Dispose()
    {
        VoiceChatService.OnParticipantUpdated -= ParticipantUpdated;
        VoiceChatService.OnConnected -= StateHasChanged;
        VoiceChatService.OnDisconnected -= Disconnected;
        VoiceChatService.OnParticipantConnected -= ParticipantUpdated;
        VoiceChatService.OnParticipantDisconnected -= ParticipantUpdated;
    }
}
