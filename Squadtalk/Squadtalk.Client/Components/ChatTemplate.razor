@using Shared.Data
@using Color = MudBlazor.Color

<MudBadge Content="Model.UnreadMessages" Overlap="true" Color="Color.Error"
          Style="max-width: 350px" Visible="Model.HasUnreadMessages">
    <div class="text-chat mud-button-root mud-button mud-button-filled
        mud-button-filled-primary mud-button-filled-size-medium mud-ripple"
         style="text-transform: none">
        <div class="me-3 ms-1" style="grid-row: 1/3">
            <ChannelImage Channel="Model"/>
        </div>

        <div class="username">@Model.Name</div>
        @if (Model.LastMessage is { } message)
        {
            <div class="channel-status" style="@StatusStyle">
                <div class="last-message">@FormatLastMessage(message)</div>
                <div class="separator">|</div>
                @* <div class="last-message-time">@message.Timestamp.ToStringFormat(Table, DateFormatMode.ChannelStatus)</div> *@
            </div>
        }
    </div>
</MudBadge>

@inherits LocalizedComponent

@inject IChannelManager ChannelManager
@inject IUserAuthenticationService UserAuthenticationService

