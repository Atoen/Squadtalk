@using Shared
@using Shared.Data
@using Squadtalk.Client.Extensions

<div class="text-chat rounded" @onclick="OpenChat">
    <div class="me-2" style="grid-row:1/3">
        <ChannelImage Channel="Model"/>
    </div>

    <div class="username">@Model.Name</div>
    @if (Model.LastMessage is { } message)
    {
        <div class="channel-status" style="@StatusStyle">
            <div class="last-message">@FormatLastMessage(message)</div>
            <div class="separator">|</div>
            <div class="last-message-time">@message.Timestamp.ToStringFormat(Table, DateFormatMode.ChannelStatus)</div>
        </div>
    }

    @if (Model.HasUnreadMessages)
    {
        <Badge Color="BadgeColor.Danger" Position="Position.Absolute" Placement="BadgePlacement.TopRight"
               IndicatorType="BadgeIndicatorType.RoundedPill" VisuallyHiddenText="unread messages">
            @Model.UnreadMessages
        </Badge>
    }
</div>

@inherits LocalizedComponent

@inject IChatService ChatService
@inject IUserAuthenticationService UserAuthenticationService

@code {

    [Parameter, EditorRequired]
    public ChannelModel Model { get; set; } = default!;

    private Task OpenChat() => ChatService.OpenChannelAsync(Model);

    private string? StatusStyle => Model.HasUnreadMessages ? "color: white; font-weight: bold" : null;

    private string FormatLastMessage(IChatMessage message)
    {
        var messageByCurrentUser = message.Author.Id == UserAuthenticationService.UserId;
        var isDm = Model is DirectMessageChannelModel;

        var authorPrefix = (messageByCurrentUser, isDm) switch
        {
            (true, _) => Table.You,
            (false, true) => string.Empty,
            _ => message.Author.Username
        };

        var messageContent = (messageByCurrentUser, message.Embed?.Type) switch
        {
            { Type: EmbedType.File } => $"{GetEmbedPrefix(messageByCurrentUser, Table)} {Table.File}",
            { Type: EmbedType.Image } => $"{GetEmbedPrefix(messageByCurrentUser, Table)} {Table.Image}",
            { Type: EmbedType.Video } => $"{GetEmbedPrefix(messageByCurrentUser, Table)} {Table.Video}",
            { Type: EmbedType.SystemMessage } => FormatSystemMessage(message.Embed, messageByCurrentUser),
            _ => message.Content
        };

        var useAuthorPrefix = !string.IsNullOrEmpty(authorPrefix) && message.Embed?.Type != EmbedType.SystemMessage;

        return useAuthorPrefix ? $"{authorPrefix}: {messageContent}": messageContent;

        static string GetEmbedPrefix(bool messageByCurrentUser, TextTable table) =>
            messageByCurrentUser ? table.MessageYouSentInfo : table.MessageSentInfo;
    }

    private string FormatSystemMessage(IMessageEmbed embed, bool byCurrentUser)
    {
        var systemMessageType = SystemMessageTypeHelper.Parse(embed[EmbedData.SystemMessageType]);

        switch (systemMessageType)
        {
            case SystemMessageType.ChannelCreated:
            {
                if (byCurrentUser) return Table.YouCreatedChannel;

                var username = embed[EmbedData.SystemMessageDataUsername];
                return Table.UserCreatedChannelTemplate.TryFormat(username);
            }
            case SystemMessageType.ChannelNameChanged:
            {
                var newName = embed[EmbedData.SystemMessageDataChannelName];
                if (byCurrentUser) return Table.YouChangedChannelNameTemplate.TryFormat(newName);

                var username = embed[EmbedData.SystemMessageDataUsername];
                return Table.UserChangedChannelNameTemplate.TryFormat(username, newName);
            }
            case SystemMessageType.ChannelNameCleared:
            {
                if (byCurrentUser) return Table.YouClearedChannelNameTemplate;

                var username = embed[EmbedData.SystemMessageDataUsername];
                return Table.UserClearedChannelNameTemplate.TryFormat(username);
            }
            case SystemMessageType.CallStarted or SystemMessageType.CallEnded:
            {
                if (byCurrentUser) return Table.YouCalled;

                var username = embed[EmbedData.SystemMessageDataUsername];
                return Table.UserCalledTemplate.TryFormat(username);
            }
            case SystemMessageType.CallMissed:
                return "CallMissed";

            case SystemMessageType.None:
            default:
                return string.Empty;
        }
    }
}
