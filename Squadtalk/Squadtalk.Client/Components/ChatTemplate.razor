@using Shared
@using Shared.Extensions
@using Squadtalk.Client.Extensions

<MudBadge Content="Channel.UnreadMessages" Overlap="true" Color="Color.Error"
          Style="max-width: 350px" Visible="Channel.HasUnreadMessages">
    <div class="text-chat box-shadow hover-primary rounded mud-typography-body1" @onclick="OpenChat">
        <div class="ms-1 me-2 d-flex" style="grid-row: 1/3">
            <ChannelImage Channel="Channel"/>
        </div>

        <div class="chat-name">@ChatName</div>
        @if (Channel.LastMessage is { } message)
        {
            <div class="channel-status" style="@StatusStyle">
                <div class="last-message">@FormatLastMessage(message)</div>
                <div class="separator">|</div>
                <div class="last-message-time">
                    @message.Timestamp.ToStringFormat(LocalizedText, DateFormatMode.ChannelStatus)
                </div>
            </div>
        }
    </div>
</MudBadge>

@implements Shared.Reactive.ISubscriber<ChannelModel>
@implements IDisposable

@inject IChannelManager ChannelManager
@inject IUserAuthenticationService UserAuthenticationService
@inject LocalizedText LocalizedText

@code {

    [Parameter, EditorRequired]
    public ChannelModel Channel { get; set; } = default!;

    private Task OpenChat() => ChannelManager.OpenChannelAsync(Channel);

    private string StatusStyle => Channel.HasUnreadMessages ? "color: white; font-weight: bold" : string.Empty;

    private string? _formattedName;
    private string ChatName => Channel.Name == string.Empty
        ? _formattedName ??= LocalizedText.R.users_group.Format(UserAuthenticationService.Username)
        : Channel.Name;

    private string FormatLastMessage(IChatMessage message)
    {
        var messageByCurrentUser = message.Author.Id == UserAuthenticationService.UserId;
        var isDm = Channel is DirectMessageChannelModel;

        var authorPrefix = (messageByCurrentUser, isDm) switch
        {
            (true, _) => LocalizedText.R.you,
            (false, true) => string.Empty,
            _ => message.Author.Username
        };

        var messageContent = (messageByCurrentUser, message.Embed?.Type) switch
        {
            { Type: EmbedType.File } => $"{GetEmbedPrefix(messageByCurrentUser, LocalizedText)} {LocalizedText.R.file}",
            { Type: EmbedType.Image } => $"{GetEmbedPrefix(messageByCurrentUser, LocalizedText)} {LocalizedText.R.image}",
            { Type: EmbedType.Video } => $"{GetEmbedPrefix(messageByCurrentUser, LocalizedText)} {LocalizedText.R.video}",
            { Type: EmbedType.SystemMessage } => FormatSystemMessage(message.Embed, messageByCurrentUser),
            _ => message.Content
        };

        var useAuthorPrefix = !string.IsNullOrEmpty(authorPrefix) && message.Embed?.Type != EmbedType.SystemMessage;

        return useAuthorPrefix ? $"{authorPrefix}: {messageContent}": messageContent;

        static string GetEmbedPrefix(bool messageByCurrentUser, LocalizedText localizedText) =>
            messageByCurrentUser ? localizedText.R.message_you_sent_info : localizedText.R.message_sent_info;
    }

    private string FormatSystemMessage(IMessageEmbed embed, bool byCurrentUser)
    {
        var systemMessageType = SystemMessageTypeHelper.Parse(embed[EmbedData.SystemMessageType]);

        switch (systemMessageType)
        {
            case SystemMessageType.ChannelCreated:
            {
                if (byCurrentUser) return LocalizedText.R.you_created_channel;

                var username = embed[EmbedData.SystemMessageDataUsername];
                return LocalizedText.R.user_created_channel_template.Format(username);
            }
            case SystemMessageType.ChannelNameChanged:
            {
                var newName = embed[EmbedData.SystemMessageDataChannelName];
                if (byCurrentUser) return LocalizedText.R.you_changed_channel_name_template.Format(newName);

                var username = embed[EmbedData.SystemMessageDataUsername];
                return LocalizedText.R.user_changed_channel_name_template.Format(username, newName);
            }
            case SystemMessageType.ChannelNameCleared:
            {
                if (byCurrentUser) return LocalizedText.R.you_cleared_channel_name;

                var username = embed[EmbedData.SystemMessageDataUsername];
                return LocalizedText.R.user_cleared_channel_name.Format(username);
            }
            case SystemMessageType.CallStarted or SystemMessageType.CallEnded:
            {
                if (byCurrentUser) return LocalizedText.R.you_called;

                var username = embed[EmbedData.SystemMessageDataUsername];
                return LocalizedText.R.user_called_template.Format(username);
            }
            case SystemMessageType.CallMissed:
                return LocalizedText.R.call_missed;

            case SystemMessageType.None:
            default:
                return string.Empty;
        }
    }

    public void OnNext(ChannelModel value) => StateHasChanged();

    private IDisposable? _subscription;

    protected override void OnInitialized() => _subscription = Channel.Subscribe(this);

    public void Dispose() => _subscription?.Dispose();
}
