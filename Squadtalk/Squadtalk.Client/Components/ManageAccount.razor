@using Squadtalk.Client.Components.dialogs
@using Color = MudBlazor.Color

<MudContainer MaxWidth="MaxWidth.Small" Gutters="false">
    <MudPaper Class="pa-4 mx-3 mb-4" Elevation="8">

        <div class="d-flex mb-4">
            <MudStack Spacing="0">
                <MudText Typo="Typo.body2" Class="mud-text-secondary mud-typography-nowrap">
                    @LocalizedText.R.username
                </MudText>
                <MudText Typo="Typo.body1">
                    @UserAuthenticationService.Username
                </MudText>
            </MudStack>
            <MudSpacer/>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="DisableMenu" OnClick="OpenChangeUsernameDialog">
                @LocalizedText.R.edit
            </MudButton>
        </div>

        <div class="d-flex my-4">
            <MudStack Spacing="0">
                <MudText Typo="Typo.body2" Class="mud-text-secondary mud-typography-nowrap">
                    @LocalizedText.R.email
                </MudText>
                <MudStack Row="true">
                    <MudText Typo="Typo.body1">@_maskedEmail</MudText>
                    <MudLink OnClick="ToggleEmailMasking" Style="user-select: none" Color="Color.Primary">
                        @ToggleButtonText
                    </MudLink>
                </MudStack>
            </MudStack>
            <MudSpacer/>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="DisableMenu" OnClick="OpenChangeEmailDialog">
                @LocalizedText.R.edit
            </MudButton>
        </div>

        <MudDivider/>

        <div class="d-flex mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="DisableMenu" OnClick="OpenChangePasswordDialog">
                @LocalizedText.R.change_password
            </MudButton>
        </div>

    </MudPaper>
</MudContainer>

@inherits LocalizedComponent

@inject IDialogService DialogService
@inject IUserAuthenticationService UserAuthenticationService

@code
{
    private string _email = default!;
    private string? _maskedEmail;
    private bool _emailMasked = true;

    private bool DisableMenu => !RendererInfo.IsInteractive;
    private string ToggleButtonText => _emailMasked ? LocalizedText.R.show : LocalizedText.R.hide;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _email = UserAuthenticationService.Email;
        _maskedEmail = MaskEmail(_email);
    }

    private void ToggleEmailMasking()
    {
        _emailMasked = !_emailMasked;
        _maskedEmail = _emailMasked ? MaskEmail(_email) : _email;
    }

    private static string MaskEmail(string email)
    {
        var atIndex = email.IndexOf('@');
        if (atIndex > 0)
        {
            return new string('*', atIndex) + email[atIndex..];
        }

        return email;
    }

    private Task OpenChangeUsernameDialog()
    {
        return DialogService.ShowAsync<ChangeUsernameDialog>(LocalizedText.R.change_username);
    }

    private Task OpenChangeEmailDialog()
    {
        return DialogService.ShowAsync<ChangeEmailDialog>(LocalizedText.R.change_email);
    }

    private Task OpenChangePasswordDialog()
    {
        return DialogService.ShowAsync<ChangePasswordDialog>(LocalizedText.R.change_password);
    }
}