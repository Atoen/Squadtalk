@using Shared.Extensions

<MudPaper Outlined="true" Class="my-2 d-flex align-center" Style="grid-row: 5">
    <MudTextField T="string" @ref="_textField" Disabled="Disable"
                  MaxLines="10" AutoGrow="true" Class="ps-1" Immediate="true"
                  id="textbox" Underline="false" OnKeyDown="OnKeyDown"
                  KeyDownPreventDefault="_inputPreventDefault"
                  Placeholder="@Placeholder" AutoFocus="true"/>

    <MudDivider Vertical="true" Class="mx-1" DividerType="DividerType.FullWidth"/>

    <div>
        <MudTooltip Text="@LocalizedText.R.send_message" Disabled="Disable">
            <MudIconButton Icon="@Icons.Material.Rounded.Send" Size="Size.Medium"
                           Class="pa-2 me-n1" OnClick="Send" Disabled="Disable"
                           Color="Color.Primary"/>
        </MudTooltip>

        <MudTooltip Text="@LocalizedText.R.add_attachment" Disabled="Disable">
            <MudIconButton Icon="@Icons.Material.Rounded.AddCircle" Size="Size.Medium"
                           Class="pa-2 me-1" HtmlTag="label" for="file-picker"
                           Disabled="Disable" Color="Color.Primary"/>
        </MudTooltip>

        <InputFile class="d-none" id="file-picker" multiple/>
    </div>
</MudPaper>


@inject IConnectionService CommunicationService
@inject ITextChatService TextChatService
@inject IChannelManager ChannelManager
@inject ILogger<InputBox> Logger
@inject LocalizedText LocalizedText

@* @inject IJSRuntime JSRuntime *@
@* @inject IFileTransferService FileTransferService *@

@code
{
    [Parameter, EditorRequired] public ChannelModel Channel { get; set; } = default!;

    private MudTextField<string> _textField = default!;
    private bool _inputPreventDefault;

    private bool Disable => !CommunicationService.Connected;
    private string Placeholder { get; set; } = default!;

    protected override void OnInitialized()
    {
        CommunicationService.ConnectionStatusChanged += ConnectionStatusChanged;
        Placeholder = LocalizedText.R.write_to_channel.Format(Channel.Name);
    }

    private Task OnKeyDown(KeyboardEventArgs e)
    {
        _inputPreventDefault = false;

        var shouldSend = e is { Key: "Enter", ShiftKey: false };
        return shouldSend ? Send() : Task.CompletedTask;
    }

    private async Task Send()
    {
        _inputPreventDefault = true;

        if (Channel.IsTemporary())
        {
            await ChannelManager.UpgradeToPersistentChannelAsync(Channel);
        }

        var text = _textField.Value;
        await _textField.Clear();

        if (!string.IsNullOrWhiteSpace(text))
        {
            await TextChatService.SendMessageAsync(text);
        }
    }

    private Task ConnectionStatusChanged(ConnectionStatus status)
    {
        StateHasChanged();

        return Task.CompletedTask;
    }

