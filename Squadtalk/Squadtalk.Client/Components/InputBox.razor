@using Shared.Data.TypedIds
@using Shared.Extensions

@if (Channel.IsSomeoneTyping)
{
    <span class="grid-row-4 d-flex gap-1 typing-indicator">
        @switch (Channel.TypingUsers.Count)
        {
            case 1:
                var user = Channel.TypingUsers.First();
                <strong>@user.Username</strong>
                @LocalizedText.R.is_typing
                break;

            case 2:
                var users = Channel.TypingUsers.Take(2).ToArray();
                <strong>@users[0].Username</strong>
                @LocalizedText.R.and
                <strong>@users[1].Username</strong>
                @LocalizedText.R.are_typing
                break;

            case > 2:
                @LocalizedText.R.several_users_are_typing
                break;
        }
    </span>
}

<MudPaper Outlined="true" Class="my-0 d-flex align-center" Style="grid-row: 5"
          @onclick="() => _textField.FocusAsync()">
    <MudTextField T="string" @ref="_textField" id="textbox"
                  Underline="false" Class="ps-1" Immediate="true"
                  KeyDownPreventDefault="_inputPreventDefault"
                  OnKeyDown="OnKeyDown" Disabled="Disable"
                  MaxLength="2000" Placeholder="@Placeholder"
                  ValueChanged="TextFieldValueChanged"
                  AutoFocus="true" MaxLines="20" AutoGrow="true"/>

    <MudDivider Vertical="true" Class="mx-1" DividerType="DividerType.FullWidth"/>

    <div @onclick:stopPropagation="true">
        <MudTooltip Text="@LocalizedText.R.send_message" Disabled="Disable" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Rounded.Send" Size="Size.Medium"
                           Class="pa-2 me-n1" OnClick="Send" Disabled="Disable"
                           Color="Color.Primary"/>
        </MudTooltip>

        <MudTooltip Text="@LocalizedText.R.add_attachment" Disabled="Disable" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Rounded.AddCircle" Size="Size.Medium"
                           Class="pa-2 me-1" HtmlTag="label" for="file-picker"
                           Disabled="Disable" Color="Color.Primary"/>
        </MudTooltip>

        <InputFile class="d-none" id="file-picker" multiple/>
    </div>
</MudPaper>

@implements ISubscriber<ChannelState>
@implements IDisposable

@inject IConnectionService CommunicationService
@inject ITextChatService TextChatService
@inject IChannelManager ChannelManager
@inject ILogger<InputBox> Logger
@inject LocalizedText LocalizedText

@* @inject IFileTransferService FileTransferService *@

@code
{
    [Parameter, EditorRequired]
    public ChannelModel Channel { get; set; } = default!;

    private IJSInProcessRuntime _runtime = default!;
    private MudTextField<string> _textField = default!;
    private bool _inputPreventDefault;
    private bool _isTyping;

    private bool Disable => !CommunicationService.Connected;
    private string Placeholder { get; set; } = default!;

    protected override void OnInitialized()
    {
        Placeholder = LocalizedText.R.write_to_channel.Format(Channel.Name);
    }

    private Task OnKeyDown(KeyboardEventArgs e)
    {
        _inputPreventDefault = false;

        var shouldSend = e is { Key: "Enter", ShiftKey: false };
        return shouldSend ? Send() : Task.CompletedTask;
    }

    private async Task Send()
    {
        _inputPreventDefault = true;

        if (Channel.IsTemporary())
        {
            await ChannelManager.UpgradeToPersistentChannelAsync(Channel);
        }

        var text = _textField.Value;
        await _textField.Clear();

        if (!string.IsNullOrWhiteSpace(text))
        {
            await TextChatService.SendMessageAsync(text);
        }
    }

    private void TextFieldValueChanged()
    {
        var channelId = Channel.Id;

        if (_textField.Value is null or { Length: 0 })
        {
            if (!_isTyping) return;
            _isTyping = false;

            TextChatService.StoppedTyping();
        }
        else
        {
            if (_isTyping) return;
            _isTyping = true;

            TextChatService.StartedTyping(channelId);
        }
    }

    private void ConnectionStatusChanged(ConnectionStatus status)
    {
        StateHasChanged();
    }

    private void TypingUsersChanged(ChannelId channelId)
    {
        if (Channel.Id == channelId)
        {
            StateHasChanged();
        }
    }

    public void OnNext(ChannelState value)
    {
        StateHasChanged();
    }

    private IDisposable? _disposable;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;

        _disposable = Channel.State.Subscribe(this);
        // CommunicationService.ConnectionStatusChanged += ConnectionStatusChanged;
        // ChannelManager.TypingUsersChanged += TypingUsersChanged;
    }

    public void Dispose()
    {
        if (!RendererInfo.IsInteractive) return;

        _disposable?.Dispose();
        // CommunicationService.ConnectionStatusChanged -= ConnectionStatusChanged;
        // ChannelManager.TypingUsersChanged -= TypingUsersChanged;

        if (_isTyping)
        {
            TextChatService.StoppedTyping();
        }
    }

