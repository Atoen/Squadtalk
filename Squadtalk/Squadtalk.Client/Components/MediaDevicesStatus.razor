<div class="status-container">
    <Tooltip Title="@MicrophoneTooltipText">
        <Dropdown Split="true" Direction="DropdownDirection.DropdownCentered">
            <DropdownActionButton Color="MicrophoneButtonColor" @onclick="NewVoiceChatService.ToggleMicrophoneAsync">
                <Icon Name="MicrophoneIconName" Size="IconSize.x5"/>
            </DropdownActionButton>
            <DropdownToggleButton Color="MicrophoneButtonColor"/>
            <DropdownMenu>
                @if (!NewVoiceChatService.MicrophoneAvailable)
                {
                    <DropdownItem>No microphones detected</DropdownItem>
                }

                @foreach (var microphone in NewVoiceChatService.Microphones)
                {
                    <DropdownItem @onclick="() => NewVoiceChatService.SelectMicrophoneAsync(microphone)" Type="ButtonType.Button">
                        @if (microphone == _selectedMicrophone)
                        {
                            <div class="d-flex flex-row">
                                <div class="device-label">@microphone.LabelOrDefault</div>
                                <Icon Name="IconName.CheckLg" Color="IconColor.Success"/>
                            </div>
                        }
                        else
                        {
                            <div class="device-label">@microphone.Label</div>
                        }
                    </DropdownItem>
                }
            </DropdownMenu>
        </Dropdown>
    </Tooltip>

    <Tooltip Title="@CameraTooltipText">
        <Dropdown Split="true" Direction="DropdownDirection.DropdownCentered">
            <DropdownActionButton Color="CameraButtonColor" @onclick="NewVoiceChatService.ToggleCameraAsync">
                <Icon Name="CameraIconName" Size="IconSize.x5"/>
            </DropdownActionButton>
            <DropdownToggleButton Color="CameraButtonColor"/>
            <DropdownMenu>
                @if (!NewVoiceChatService.CameraAvailable)
                {
                    <DropdownItem>No cameras detected</DropdownItem>
                }

                @foreach (var camera in NewVoiceChatService.Cameras)
                {
                    <DropdownItem @onclick="() => NewVoiceChatService.SelectCameraAsync(camera)" Type="ButtonType.Button">
                        @if (camera == _selectedCamera)
                        {
                            <div class="d-flex flex-row">
                                <div class="device-label">@camera.LabelOrDefault</div>
                                <Icon Name="IconName.CheckLg" Color="IconColor.Success"/>
                            </div>
                        }
                        else
                        {
                            <div class="device-label">@camera.Label</div>
                        }
                    </DropdownItem>
                }
                <DropdownDivider/>

                @if (NewVoiceChatService.CameraAvailable)
                {
                    <DropdownItem @onclick="NewVoiceChatService.SwapCameraAsync" Type="ButtonType.Button">
                        <div class="d-flex flex-row gap-1">
                            <Icon Name="IconName.ArrowRepeat" Color="IconColor.Primary"/>
                            Swap camera
                        </div>
                    </DropdownItem>
                }
            </DropdownMenu>
        </Dropdown>
    </Tooltip>

    <Tooltip Title="@ScreenShareTooltipText">
        <Button Color="ScreenShareButtonColor" @onclick="NewVoiceChatService.ToggleScreenShareAsync">
            <Icon Name="ScreenShareIconName" Size="IconSize.x5"/>
        </Button>
    </Tooltip>

    <Tooltip Title="Leave call">
        <Button Color="ButtonColor.Danger" @onclick="NewVoiceChatService.LeaveCallAsync">
            <Icon Name="IconName.TelephoneXFill" Size="IconSize.x5"/>
        </Button>
    </Tooltip>
</div>

@inject INewVoiceChatService NewVoiceChatService

@code {

    private MediaDeviceModel? _selectedMicrophone;
    private MediaDeviceModel? _selectedCamera;

    private ButtonColor MicrophoneButtonColor => NewVoiceChatService.MicrophoneEnabled ? ButtonColor.Primary : ButtonColor.Secondary;
    private ButtonColor CameraButtonColor => NewVoiceChatService.CameraEnabled ? ButtonColor.Primary : ButtonColor.Secondary;
    private ButtonColor ScreenShareButtonColor => NewVoiceChatService.ScreenShareEnabled ? ButtonColor.Primary : ButtonColor.Secondary;

    private IconName MicrophoneIconName => NewVoiceChatService.MicrophoneEnabled ? IconName.MicFill : IconName.MicMuteFill;
    private IconName CameraIconName => NewVoiceChatService.CameraEnabled ? IconName.CameraVideoFill : IconName.CameraVideoOffFill;
    private IconName ScreenShareIconName => NewVoiceChatService.ScreenShareEnabled ? IconName.DisplayFill : IconName.Display;

    private string MicrophoneTooltipText => NewVoiceChatService.MicrophoneEnabled ? "Disable microphone" : "Enable microphone";
    private string CameraTooltipText => NewVoiceChatService.CameraEnabled ? "Disable camera" : "Enable camera";
    private string ScreenShareTooltipText => NewVoiceChatService.ScreenShareEnabled ? "Stop screen share" : "Share your screen";
}
