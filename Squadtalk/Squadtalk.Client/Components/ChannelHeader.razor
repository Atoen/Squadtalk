@using Squadtalk.Client.Components.dialogs

<MudPaper Class="d-flex mud-theme-primary align-center mx-1">
    <div class="mud-typography-h6 order-2 mx-2">@ChatName</div>

    @if (!Chat.IsGlobal())
    {
        <div class="order-1 d-flex ps-2">
            <ChannelImage Chat="Chat" Small="true"/>
        </div>

        <div class="order-3 d-flex ms-auto">
            @if (!VoiceChatService.ActiveCallOnCurrentChannel)
            {
                <MudTooltip Text="@LocalizedText.R.start_call" Class="z-100">
                    <MudIconButton Icon="@Icons.Material.Rounded.Call" Color="Color.Inherit"/>
                </MudTooltip>
            }

            @if (Chat is GroupChatModel)
            {
                <MudTooltip Text="@LocalizedText.R.add_friends_to_group" Class="z-100">
                    <MudIconButton Icon="@Icons.Material.Rounded.PersonAddAlt"
                                   Color="Color.Inherit" OnClick="OpenAddToGroupDialog"/>
                </MudTooltip>

                <MudTooltip Text="@LocalizedText.R.manage_group" Class="z-100">
                    <MudMenu Icon="@Icons.Material.Rounded.Settings" ListClass="pa-1 z-90"
                             Color="Color.Inherit" Dense="true" MaxHeight="300"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">

                        @if (Chat.LocalUser.CanChangeGroupNameAndImage())
                        {
                            <MudMenuItem Icon="@Icons.Material.Rounded.Edit"
                                         OnClick="OpenChangeGroupNameDialog">
                                @LocalizedText.R.group_name
                            </MudMenuItem>

                            <MudMenuItem Icon="@Icons.Material.Rounded.Image">
                                @LocalizedText.R.group_image
                            </MudMenuItem>

                            <MudDivider Class="my-1"/>
                        }

                        <MudMenuItem Icon="@Icons.Material.Rounded.People"
                                     OnClick="OpenGroupMembersDialog">
                            @LocalizedText.R.group_members
                        </MudMenuItem>

                        @if (Chat.LocalUser.CanAddNewMembers())
                        {
                            <MudMenuItem Icon="@Icons.Material.Rounded.PersonAddAlt"
                                         OnClick="OpenAddToGroupDialog">
                                @LocalizedText.R.add_friends_to_group
                            </MudMenuItem>
                        }

                        <MudDivider Class="my-1"/>

                        <MudMenuItem Icon="@Icons.Material.Rounded.ExitToApp"
                                     IconColor="Color.Error" OnClick="OpenLeaveGroupDialog">
                            @LocalizedText.R.leave_group
                        </MudMenuItem>

                        @if (Chat.LocalUser.CanDeleteGroup())
                        {
                            <MudDivider Class="my-1"/>

                            <MudMenuItem Icon="@Icons.Material.Rounded.DeleteForever"
                                         IconColor="Color.Error" OnClick="DeleteGroup">
                                @LocalizedText.R.delete_group
                            </MudMenuItem>
                        }

                    </MudMenu>
                </MudTooltip>
            }
        </div>

        @* <VoiceCallStatus/> *@
    }
</MudPaper>

@implements ISubscriber<ChatModel>
@implements IDisposable

@inject IChatManager ChatManager
@inject IVoiceChatService VoiceChatService
@inject LocalizedText LocalizedText
@inject IDialogService DialogService
@inject ILogger<ChannelHeader> Logger

@code
{
    [Parameter, EditorRequired]
    public ChatModel Chat { get; set; } = default!;

    private string? _formattedName;

    private string ChatName => Chat.Name == string.Empty
        ? _formattedName ??= LocalizedText.R.users_group.Format(Chat.LocalUser.Username())
        : Chat.Name;

    private Task StartVoiceCall()
    {
        return VoiceChatService.StartCallAsync(Chat.Id);
    }

    private async Task<bool> ChangeGroupName(GroupChatModel groupChat, string? newName)
    {
        Logger.LogInformation("New name {NewName}", newName);

        var changedName = await ChatManager.ChangeGroupChatNameAsync(groupChat, newName);

        return changedName;
    }

    private async Task AddFriendsToGroupAsync(List<UserModel> friends)
    {
        _addFriendsDialogReference?.Close();
        _addFriendsDialogReference = null;

        if (friends.Count != 0)
        {
            await ChatManager.AddFriendsToGroupAsync(Chat, friends);
        }
    }

    private DialogParameters<SelectFriendsDialog>? _addFriendsDialogParameters;

    private IDialogReference? _addFriendsDialogReference;

    private async Task OpenAddToGroupDialog()
    {
        _addFriendsDialogParameters ??= new DialogParameters<SelectFriendsDialog>
        {
            { x => x.OnSelection, EventCallback.Factory.Create<List<UserModel>>(this, AddFriendsToGroupAsync) },
            { x => x.SelectionType, SelectFriendsDialog.FriendsSelectionType.InviteToGroup }
        };

        _addFriendsDialogReference = await DialogService.ShowAsync<SelectFriendsDialog>(
            LocalizedText.R.add_friends_to_group, _addFriendsDialogParameters, DialogOptions);
    }

    private DialogOptions? _dialogOptions;
    private DialogParameters? _manageDialogOptions;

    private DialogOptions DialogOptions => _dialogOptions ??= new DialogOptions { Position = DialogPosition.TopCenter };
    private DialogParameters ManageDialogParameters => _manageDialogOptions ??= new DialogParameters
    {
        { "GroupChat", Chat as GroupChatModel }
    };

    private Task OpenChangeGroupNameDialog()
    {
         return DialogService.ShowAsync<ChangeGroupNameDialog>(
            LocalizedText.R.change_group_name, ManageDialogParameters, DialogOptions);
    }

    private Task OpenChangeGroupImageDialog()
    {
        return Task.CompletedTask;
    }

    private Task OpenGroupMembersDialog()
    {
        return DialogService.ShowAsync<GroupMembersDialog>(
            LocalizedText.R.group_members, ManageDialogParameters, DialogOptions);
    }

    private Task OpenLeaveGroupDialog()
    {
        return DialogService.ShowAsync<LeaveGroupDialog>(
            LocalizedText.R.leave_group, ManageDialogParameters, DialogOptions);
    }

    private Task DeleteGroup()
    {
        return DialogService.ShowAsync<DeleteGroupDialog>(
            LocalizedText.R.delete_group, ManageDialogParameters, DialogOptions);
    }

    public void OnNext(ChatModel value) => StateHasChanged();

    private IDisposable? _subscription;

    protected override void OnInitialized() => _subscription = Chat.Subscribe(this);

    public void Dispose() => _subscription?.Dispose();
}
