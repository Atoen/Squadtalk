@using Squadtalk.Client.Localization
<ul class="nav nav-pills flex-row">
    <li class="nav-item px-1">
        <NavLink class="nav-link" href="Messages" Match="NavLinkMatch.All">@_table.Messages</NavLink>
    </li>
    <li class="nav-item px-1">
        <NavLink class="nav-link" href="Users">@_table.Users</NavLink>
    </li>
</ul>

@inject ILocalization Localization

@code
{
    private TextTable _table = default!;

    protected override void OnInitialized()
    {
        _table = Localization.GetTextTable(this);
    }
}
