<MudPaper Width="250px" Class="py-3" Elevation="0" Square="true">
    <MudNavMenu Color="Color.Primary">
        <MudText Typo="Typo.h5" Class="px-4">Squadtalk</MudText>
        <MudDivider Class="my-2"/>

        <MudNavLink Href="/Chats" Icon="@Icons.Material.Rounded.Chat">@_textTable.messages</MudNavLink>
        <MudNavLink Href="/Users" Icon="@Icons.Material.Rounded.People">@_textTable.users</MudNavLink>
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Home">@_textTable.home</MudNavLink>
        <MudNavLink Href="/Canvas" Icon="@Icons.Material.Rounded.Palette">@_textTable.canvas</MudNavLink>
        <MudNavLink Href="/Settings" Icon="@Icons.Material.Rounded.Settings">@_textTable.settings</MudNavLink>

        <AuthorizeView>
            <Authorized>
                <MudNavLink Href="/Account/Manage" Icon="@Icons.Material.Rounded.Person">@context.User.Identity?.Name</MudNavLink>
                <MudNavLink Href="/Account/Logout" ForceLoad="true" Icon="@Icons.Material.Rounded.Logout">
                    @_textTable.logout
                </MudNavLink>
            </Authorized>
            <NotAuthorized>
                <MudNavLink Href="/Account/Register" Icon="@Icons.Material.Rounded.PersonAdd">
                    @_textTable.register
                </MudNavLink>
                <MudNavLink Href="/Account/Login" Icon="@Icons.Material.Rounded.Login">
                    @_textTable.login
                </MudNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudNavMenu>
</MudPaper>

