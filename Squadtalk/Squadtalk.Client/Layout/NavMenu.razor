<MudPaper Width="250px" Class="py-1" Elevation="0" Square="true">
    <MudNavMenu Color="Color.Primary" Bordered="true">
        <MudText Typo="Typo.h5" Class="px-4 pt-2" Color="Color.Primary">Squadtalk</MudText>

        <AuthorizeView>
            <Authorized>
                <StatusDisplay/>
            </Authorized>
        </AuthorizeView>

        <MudDivider Class="my-1"/>

        <MudNavLink Href="@Routes.Pages.Chats" Icon="@Icons.Material.Rounded.Chat">@_textTable.messages</MudNavLink>
        <MudNavLink Href="@Routes.Pages.Contacts" Icon="@Icons.Material.Rounded.People">@_textTable.contacts</MudNavLink>
        <MudNavLink Href="@Routes.Pages.Root" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Home">
            @_textTable.home
        </MudNavLink>
        <MudNavLink Href="@Routes.Pages.Canvas" Icon="@Icons.Material.Rounded.Palette">@_textTable.canvas</MudNavLink>
        <MudNavLink Href="@Routes.Pages.Settings" Icon="@Icons.Material.Rounded.Settings">
            @_textTable.settings
        </MudNavLink>

        <AuthorizeView>
            <Authorized>
                <div class="mud-nav-item">
                    <form class="mud-width-full" action="@Routes.Endpoints.LogOut" method="post">
                        <AntiforgeryToken/>
                        <input type="hidden" name="ReturnUrl" value=""/>
                        <button class="mud-nav-link mud-ripple">
                            <MudIcon Icon="@Icons.Material.Rounded.Logout" Color="Color.Default" Class="me-3"/>
                            @_textTable.logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <MudNavLink Href="@Routes.Pages.Register" Icon="@Icons.Material.Rounded.PersonAdd">
                    @_textTable.register
                </MudNavLink>
                <MudNavLink Href="@Routes.Pages.Login" Icon="@Icons.Material.Rounded.Login">
                    @_textTable.login
                </MudNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudNavMenu>
</MudPaper>


@using Shared.Routing
@using Squadtalk.Client.Components
@using Squadtalk.Client.Localization
@implements IDisposable

@inject NavigationManager NavigationManager
@inject LocalizedText LocalizedText

@code {

    private string? _currentUrl;

    private LocalizedText.TextTable _textTable = default!;

    protected override void OnInitialized()
    {
        _textTable = LocalizedText.GetTextTable(this);

        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
