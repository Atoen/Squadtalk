@using Squadtalk.Client.Localization
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid d-flex justify-content-center" style="z-index: 1">
        <a class="navbar-brand" href="">Squadtalk</a>
    </div>
    
    @if (!OperatingSystem.IsBrowser())
    {
        <div class="progress-bar"></div>
    }
    else
    {
        <div class="finished-loading"></div>
    }
    
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Channels">
                <Icon Name="IconName.ChatLeftTextFill" Size="IconSize.x4" Class="mx-2"/> @_textTable.Messages
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <Icon Name="IconName.HouseFill" Size="IconSize.x4" Class="mx-2"/> @_textTable.Home
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Canvas">
                <Icon Name="IconName.PaletteFill" Size="IconSize.x4" Class="mx-2"/> @_textTable.Canvas
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Settings">
                <Icon Name="IconName.List" Size="IconSize.x4" Class="mx-2"/> @_textTable.Settings
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <Icon Name="IconName.PersonFill" Size="IconSize.x4" Class="mx-2"/> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken/>
                        <input type="hidden" name="ReturnUrl" value=""/>
                        <button type="submit" class="nav-link">
                            <Icon Name="IconName.ArrowBarLeft" Size="IconSize.x4" Class="mx-2"/> @_textTable.Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <Icon Name="IconName.PersonAdd" Size="IconSize.x4" Class="mx-2"/> @_textTable.Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <Icon Name="IconName.PersonBadge" Size="IconSize.x4" Class="mx-2"/> @_textTable.Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@inject NavigationManager NavigationManager
@inject ILocalization Localization

@code {
    
    private string? _currentUrl;

    private TextTable _textTable = default!;
    
    protected override void OnInitialized()
    {
        _textTable = Localization.GetTextTable(this);

        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
