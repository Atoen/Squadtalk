@using Shared.Data.TypedIds
@using Shared.Models
@using Squadtalk.Client.Components

@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="@_isDarkTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu/>
        <MiniCallInfo/>
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@implements IDisposable

@inject ICommunicationService CommunicationService
@inject IVoiceChatService VoiceChatService
@inject IUserPreferencesService UserPreferences
@inject IUserAuthenticationService UserAuthenticationService
@inject ILogger<MainLayout> Logger
@inject PersistentComponentState PersistentComponentState

@code
{
    private PersistingComponentStateSubscription _subscription;

    private bool _isDarkTheme;

    protected override Task OnInitializedAsync()
    {
        _subscription = PersistentComponentState.RegisterOnPersisting(OnPersisting);

        VoiceChatService.CallIncoming += CallIncoming;
        UserPreferences.UseDarkModeChanged += UseDarkModeChanged;

        _isDarkTheme = UserPreferences.UseDarkMode;

        return UserAuthenticationService.IsAuthenticated
            ? CommunicationService.ConnectAsync()
            : Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (UserAuthenticationService.IsAuthenticated)
        {
            await VoiceChatService.InitializeAsync();
        }
    }

    private Task OnPersisting()
    {
        if (CommunicationService is IPersistState persist)
        {
            return persist.PersistDataAsync();
        }

        return Task.CompletedTask;
    }

    private async Task CallIncoming(ChannelModel channel)
    {
        // return _callIncomingModal.ShowAsync<IncomingCallModal>(
        //     title: Localization.TextTable.CallIncomingTemplate.TryFormat(channel.Name),
        //     parameters: _modalParameters);
    }

    private void UseDarkModeChanged()
    {
        var useDarkMode = UserPreferences.UseDarkMode;
        if (useDarkMode != _isDarkTheme)
        {
            _isDarkTheme = useDarkMode;
            StateHasChanged();
        }
    }

    private async Task CallAcceptedDecisionCallback(bool accepted, ChannelId channelId)
    {
        // await _callIncomingModal.HideAsync();

        if (accepted)
        {
            await VoiceChatService.AcceptCallAsync(channelId);
        }
        else
        {
            await VoiceChatService.DeclineCallAsync(channelId);
        }
    }

    public void Dispose()
    {
        _subscription.Dispose();
        VoiceChatService.CallIncoming -= CallIncoming;
        UserPreferences.UseDarkModeChanged -= UseDarkModeChanged;
    }
}
