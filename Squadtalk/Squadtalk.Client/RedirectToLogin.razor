@inject NavigationManager NavigationManager

@code {
    protected override sealed void OnInitialized()
    {
        var returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.NavigateTo($"Profile/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
        // NavigationManager.NavigateTo($"Account/Login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
