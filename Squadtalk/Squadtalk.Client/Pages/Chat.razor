@attribute [Authorize]
@attribute [Route(Routes.Pages.Chat)]

@using Microsoft.AspNetCore.Authorization
@using Shared.Data.TypedIds

@implements IAsyncDisposable

<PageTitle>Squadtalk | @_channel?.Name</PageTitle>

<div class="chat-container">
    @if (_channel is not null)
    {
        <ChannelHeader Chat="_channel"/>
    }

    <div class="message-listbox rounded mt-2" id="listbox">
        <InfiniteScrolling>
            <ItemTemplate>
                <MessageTemplate Model="context" @key="context"/>
            </ItemTemplate>
        </InfiniteScrolling>
    </div>

    <UploadInfo/>

    @if (_channel is not null)
    {
        <InputBox Chat="_channel"/>
    }
</div>

@inject IChatManager ChatManager
@inject IFileTransferService FileTransferService
@inject NavigationManager NavigationManager
@inject IRtcConnectionService RtcConnectionService
@inject IConnectionService ConnectionService

@code {

    [Parameter]
    public string ChannelId { get; set; } = default!;

    private ChatModel? _channel;

    protected override async Task OnInitializedAsync()
    {
        await ConnectionService.ConnectAsync();

        if (ChatManager.CurrentChat is not { } currentChannel)
        {
            var channel = ChatManager.GetChannel(new GroupId(ChannelId));
            if (channel is null)
            {
                NavigationManager.NavigateTo(Routes.Pages.Chats, replace: true);
                return;
            }

            _channel = channel;
            await ChatManager.OpenChannelAsync(_channel, false);
        }
        else
        {
            _channel = currentChannel;
        }

        await RtcConnectionService.GroupHasActiveCallAsync(_channel);
    }

    private void ChatChanged()
    {
        _channel = ChatManager.CurrentChat;
    }

    public async ValueTask DisposeAsync()
    {
        ChatManager.ChatChanged -= ChatChanged;

        ChatManager.ClearChannelSelection();

        if (FileTransferService.UploadChannel is not { } channel) return;

        // var toast = new ToastMessage(ToastType.Success, $"Your upload to {channel.Name} is still in progress.");
        // ToastService.Notify(toast);
    }
}
