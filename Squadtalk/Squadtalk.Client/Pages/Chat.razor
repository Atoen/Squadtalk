@page "/Channels/{ChannelId}"

@using Microsoft.AspNetCore.Authorization
@using Shared.Data.TypedIds

@implements IAsyncDisposable

@attribute [Authorize]

<PageTitle>Squadtalk | @ChatService.CurrentChannel?.Name</PageTitle>

<div class="chat-container">
    @if (_channel is not null)
    {
        <ChannelHeader Channel="_channel"/>
    }

    <div class="message-listbox rounded mt-2" id="listbox">
        @if (OperatingSystem.IsBrowser())
        {
            <InfiniteScrolling>
                <ItemTemplate>
                    <MessageTemplate Model="context" @key="context"/>
                </ItemTemplate>
                <LoadingTemplate>
                    @* <Spinner Type="SpinnerType.Border" Class="ms-2" /> *@
                </LoadingTemplate>
            </InfiniteScrolling>
        }
        else
        {
            @* <Spinner Type="SpinnerType.Border" Class="ms-2" /> *@
        }
    </div>

    <UploadInfo/>
    <InputBox/>
</div>

@inject IChatService ChatService
@* @inject ToastService ToastService *@
@inject IFileTransferService FileTransferService
@inject NavigationManager NavigationManager
@inject IVoiceChatService VoiceChatService
@inject ICommunicationService CommunicationService

@code {

    [Parameter]
    public string ChannelId { get; set; } = default!;

    private ChannelModel? _channel;

    protected override async Task OnInitializedAsync()
    {
        await CommunicationService.ConnectAsync();

        if (ChatService.CurrentChannel is null)
        {
            var channel = ChatService.GetChannel(new ChannelId(ChannelId));
            if (channel is null)
            {
                NavigationManager.NavigateTo("/Channels", replace: true);
                return;
            }

            _channel = channel;
            await ChatService.OpenChannelAsync(_channel, false);
        }

        VoiceChatService.CurrentChannelCallChanged += StateHasChanged;
        ChatService.ChannelChanged += StateHasChanged;

        await VoiceChatService.CheckIfChannelHasActiveCallAsync(VoiceChatService.CurrentChannel!);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        return firstRender ? VoiceChatService.InitializeAsync() : Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        VoiceChatService.CurrentChannelCallChanged -= StateHasChanged;
        ChatService.ChannelChanged -= StateHasChanged;

        await ChatService.ClearChannelSelectionAsync();

        if (FileTransferService.UploadChannel is not { } channel) return;

        // var toast = new ToastMessage(ToastType.Success, $"Your upload to {channel.Name} is still in progress.");
        // ToastService.Notify(toast);
    }
}
