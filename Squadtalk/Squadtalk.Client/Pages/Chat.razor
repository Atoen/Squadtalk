@page "/Messages/Chat"

@using Microsoft.AspNetCore.Authorization
@using Squadtalk.Client.Localization

@implements IAsyncDisposable

@attribute [Authorize]

<PageTitle>Squadtalk | @ChatService.CurrentChannel?.Name;</PageTitle>

<div class="chat-container">

    @if (ChatService.CurrentChannel is { } channel)
    {
        <ChannelHeader Channel="channel"/>
    }

    <div class="message-listbox rounded mt-2" id="listbox">
        <InfiniteScrolling>
            <ItemTemplate>
                <MessageTemplate Model="context"/>
            </ItemTemplate>
            <LoadingTemplate>
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </LoadingTemplate>
        </InfiniteScrolling>
    </div>

    <UploadInfo/>
    <InputBox/>
</div>

@inject IChatService ChatService
@inject ToastService ToastService
@inject IFileTransferService FileTransferService
@inject NavigationManager NavigationManager
@inject IVoiceChatService VoiceChatService
@inject ILocalization Localization
@inject ILogger<Chat> Logger

@code {

    // private Modal _callIncomingModal = default!;
    private TextTable _table = default!;

    protected override async Task OnInitializedAsync()
    {
        if (ChatService.CurrentChannel is null)
        {
            NavigationManager.NavigateTo("/Messages", replace: true);
            return;
        }

        _table = Localization.GetTextTable(this);

        // VoiceChatService.OnCallIncoming += ShowCallPopup;
        VoiceChatService.OnCurrentChannelCallChanged += StateHasChanged;

        await VoiceChatService.CheckIfChannelHasActiveCallAsync(VoiceChatService.CurrentChannel!);
    }

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender ? VoiceChatService.InitializeAsync() : Task.CompletedTask;

    // private async Task ShowCallPopup(ChannelModel channel)
    // {
    //     _options.YesButtonText = _table.AcceptCall;
    //     _options.NoButtonText = _table.DeclineCall;
    //
    //     Logger.LogInformation("Incoming call - showing dialog");
    //
    //     await _callIncomingModal.ShowAsync();
    // }
    
    public async ValueTask DisposeAsync()
    {
        // VoiceChatService.OnCallIncoming -= ShowCallPopup;
        VoiceChatService.OnCurrentChannelCallChanged -= StateHasChanged;

        await ChatService.ClearChannelSelectionAsync();

        if (FileTransferService.UploadChannel is not { } channel) return;

        var toast = new ToastMessage(ToastType.Success, $"Your upload to {channel.Name} is still in progress.");
        ToastService.Notify(toast);
    }
}
