@page "/Messages/Chat"

@using Microsoft.AspNetCore.Authorization
@using Shared.Extensions
@using Squadtalk.Client.Extensions
@using Squadtalk.Client.Localization

@implements IDisposable

@attribute [Authorize]

<PageTitle>Squadtalk | @ChannelName</PageTitle>

<ConfirmDialog @ref="_dialog" />

<div class="header">
    <span class="channel-name">@ChannelName</span>
    @if (!IsGlobalChat)
    {
        if (!VoiceChatService.ActiveCallOnCurrentChannel)
        {
            <Button @onclick="StartVoiceCall" TooltipTitle="@_table.StartCall" Style="grid-column: 3"
                    TooltipPlacement="TooltipPlacement.Bottom">
                <Icon Name="IconName.TelephoneOutboundFill" Size="IconSize.x3"/>
            </Button>
        }

        if (ChatService.CurrentChannel is DirectMessageChannelModel)
        {
            <img alt="@ChannelName Avatar" src="User.png" class="avatar"/>
        }
        else
        {
            <Button TooltipTitle="@_table.ManageChannel" Style="grid-column: 4"
                    TooltipPlacement="TooltipPlacement.Bottom">
                <Icon Name="IconName.GearFill" Size="IconSize.x3"/>
            </Button>
        }
    }
</div>

<div class="chat-container">
    <VoiceCallStatus/>

    <div class="message-listbox rounded my-1" id="listbox">
        <InfiniteScrolling>
            <ItemTemplate>
                <MessageTemplate Model="context"/>
            </ItemTemplate>
            <LoadingTemplate>
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </LoadingTemplate>
        </InfiniteScrolling>
    </div>

    <UploadInfo/>
    <InputBox/>
</div>

@inject IChatService ChatService
@inject ToastService ToastService
@inject IFileTransferService FileTransferService
@inject NavigationManager NavigationManager
@inject IVoiceChatService VoiceChatService
@inject ILogger<Chat> Logger
@inject ILocalization Localization

@code {

    private ConfirmDialog _dialog = default!;
    private TextTable _table = default!;

    private readonly ConfirmDialogOptions _options = new()
    {
        IsVerticallyCentered = true,
        Dismissable = true,
        YesButtonColor = ButtonColor.Success,
        NoButtonColor = ButtonColor.Danger,
        Size = DialogSize.Small
    };
    
    private string? ChannelName => ChatService.CurrentChannel?.Name;
    private bool IsGlobalChat => ChatService.CurrentChannel.IsGlobal();

    protected override async Task OnInitializedAsync()
    {
        _table = Localization.GetTextTable(this);

        if (ChatService.CurrentChannel is null)
        {
            NavigationManager.NavigateTo("/Messages");
            return;
        }

        VoiceChatService.OnCallIncoming += ShowCallPopup;
        VoiceChatService.OnCurrentChannelCallChanged += StateHasChanged;

        await VoiceChatService.CheckIfChannelHasActiveCallAsync(VoiceChatService.CurrentChannel!);
    }

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender ? VoiceChatService.InitializeAsync() : Task.CompletedTask;

    private async Task ShowCallPopup(ChannelModel channel)
    {
        _options.YesButtonText = _table.AcceptCall;
        _options.NoButtonText = _table.DeclineCall;

        var accept = await _dialog.ShowAsync(_table.CallIncomingTemplate.TryFormat(channel.Name),
            _table.AcceptCallDialogMessage, _options);

        if (accept)
        {
            await VoiceChatService.AcceptCallAsync(channel.Id);
        }
        else
        {
            await VoiceChatService.DeclineCallAsync(channel.Id);
        }
    }

    private async Task StartVoiceCall()
    {
        if (ChatService.CurrentChannel is not { Id: { } channelId })
        {
            return;
        }

        Logger.LogInformation("Starting call");
        await VoiceChatService.StartCallAsync(channelId);
    }
    
    public void Dispose()
    {
        VoiceChatService.OnCallIncoming -= ShowCallPopup;
        VoiceChatService.OnCurrentChannelCallChanged += StateHasChanged;

        if (FileTransferService.UploadChannel is not { } channel) return;

        var toast = new ToastMessage(ToastType.Success, $"Your upload to {channel.Name} is still in progress.");
        ToastService.Notify(toast);
    }
}
