@attribute [Route(Routes.Pages.Chat)]

@using Microsoft.AspNetCore.Authorization
@using Shared.Data.TypedIds

@implements IAsyncDisposable

@attribute [Authorize]

<PageTitle>Squadtalk | @ChannelManager.CurrentChannel?.Name</PageTitle>

<div class="chat-container">
    @if (_channel is not null)
    {
        <ChannelHeader Channel="_channel"/>
    }

    <div class="message-listbox rounded mt-2" id="listbox">
        @if (OperatingSystem.IsBrowser())
        {
            <InfiniteScrolling>
                <ItemTemplate>
                    <MessageTemplate Model="context" @key="context"/>
                </ItemTemplate>
                <LoadingTemplate>
                    @* <Spinner Type="SpinnerType.Border" Class="ms-2" /> *@
                </LoadingTemplate>
            </InfiniteScrolling>
        }
        else
        {
            @* <Spinner Type="SpinnerType.Border" Class="ms-2" /> *@
        }
    </div>

    <UploadInfo/>
    <InputBox/>
</div>

@inject IChannelManager ChannelManager
@* @inject ToastService ToastService *@
@inject IFileTransferService FileTransferService
@inject NavigationManager NavigationManager
@inject IVoiceChatService VoiceChatService
@inject IConnectionService ConnectionService

@code {

    [Parameter]
    public string ChannelId { get; set; } = default!;

    private ChannelModel? _channel;

    protected override async Task OnInitializedAsync()
    {
        await ConnectionService.ConnectAsync();

        if (ChannelManager.CurrentChannel is null)
        {
            var channel = ChannelManager.GetChannel(new ChannelId(ChannelId));
            if (channel is null)
            {
                NavigationManager.NavigateTo(Routes.Pages.Chats, replace: true);
                return;
            }

            _channel = channel;
            await ChannelManager.OpenChannelAsync(_channel, false);
        }

        VoiceChatService.CurrentChannelCallChanged += StateHasChanged;
        ChannelManager.ChannelChanged += StateHasChanged;

        await VoiceChatService.CheckIfChannelHasActiveCallAsync(VoiceChatService.CurrentChannel!);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        return firstRender ? VoiceChatService.InitializeAsync() : Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        VoiceChatService.CurrentChannelCallChanged -= StateHasChanged;
        ChannelManager.ChannelChanged -= StateHasChanged;

        await ChannelManager.ClearChannelSelectionAsync();

        if (FileTransferService.UploadChannel is not { } channel) return;

        // var toast = new ToastMessage(ToastType.Success, $"Your upload to {channel.Name} is still in progress.");
        // ToastService.Notify(toast);
    }
}
