@attribute [Authorize]
@attribute [Route(Routes.Pages.Contacts)]

@using Microsoft.AspNetCore.Authorization
@using Squadtalk.Client.Services

<PageTitle>Squadtalk | @LocalizedText.R.contacts</PageTitle>

<h2 class="mud-primary-text mb-2">@LocalizedText.R.contacts</h2>

<MudTabs PanelClass="pa-4" Color="Color.Surface" Rounded="true"
         @bind-ActivePanelIndex="TabState.SelectedTabIndex">
    <MudTabPanel Text="@LocalizedText.R.friends">
        <FriendList/>
    </MudTabPanel>
    <MudTabPanel Text="@LocalizedText.R.friend_requests"
                 BadgeData="RequestTabBadgeData">
        <FriendRequests/>
    </MudTabPanel>
    <MudTabPanel Text="@LocalizedText.R.add_friend">
        <AddFriend/>
    </MudTabPanel>
</MudTabs>

@inject IContactManager ContactManager
@inject LocalizedText LocalizedText
@inject ContactTabState TabState

@code
{
    private object? RequestTabBadgeData =>
        ContactManager.IncomingFriendRequests is { Count: > 0 and var count } ? count : null;

    protected override async Task OnInitializedAsync()
    {
        await ContactManager.GetPendingFriendRequestsAsync();
    }
}
