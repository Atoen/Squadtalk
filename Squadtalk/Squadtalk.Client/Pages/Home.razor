@page "/"
@using Squadtalk.Client.Localization

<PageTitle>Squadtalk | Home</PageTitle>

<h1>@_textTable.HelloWorld</h1>

@_textTable.WelcomeToApp

@inject ILocalization Localization

@code {

    private TextTable _textTable = default!;

    protected override void OnInitialized()
    {
        _textTable = Localization.GetTextTable(this);
    }
}
