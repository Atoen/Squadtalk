@using Squadtalk.Client.Components.dialogs
@attribute [Route(Routes.Pages.Root)]

<PageTitle>Squadtalk | Home</PageTitle>

<h1>@Table.R.hello_world</h1>

@Table.R.welcome_to_app

@if (!RendererInfo.IsInteractive)
{
    <p>Not interactive</p>
}
else
{
    <p>Interactive</p>
}

<p>@RendererInfo.Name</p>

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Open">Open</MudButton>

@inject LocalizedText Table
@inject IDialogService DialogService

@code
{
    private Task Open()
    {
        return DialogService.ShowAsync<ChangeEmailDialog>(Table.R.change_email);
    }
}
