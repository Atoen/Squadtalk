@page "/Channels"
@using Microsoft.AspNetCore.Authorization
@using Squadtalk.Client.Layout
@using Squadtalk.Client.Localization

@attribute [Authorize]
@layout ChatLayout

<PageTitle>Squadtalk | Messages</PageTitle>

<Modal @ref="_createGroupModal" Size="ModalSize.Regular"
       UseStaticBackdrop="true" HeaderCssClass="justify-content-between"/>

<div class="channels">
    <div class="top">
        <div class="global rounded" @onclick="() => ChatService.OpenChannelAsync(ChatService.GlobalChat)">
            <Icon Name="IconName.Globe2" Size="IconSize.x2" />
            <span class>Global</span>

            @if (ChatService.GlobalChat.State is { UnreadMessages: > 0 and var unread })
            {
            <Badge Color="BadgeColor.Danger"
                   Position="Position.Absolute"
                   Placement="BadgePlacement.TopRight"
                   IndicatorType="BadgeIndicatorType.RoundedPill"
                   VisuallyHiddenText="unread messages">
                @unread
            </Badge>
            }
        </div>

        <Button Color="ButtonColor.Primary" @onclick="DisplayGroupModal" TooltipTitle="@_table.CreateChannelTooltip"
                TooltipColor="TooltipColor.Dark">
            <Icon Name="IconName.PlusSquare" Size="IconSize.x5"/>
        </Button>
    </div>

    @foreach (var channel in ChannelManager.Channels)
    {
        <ChatTemplate @key="channel.Id" Model="@channel" />
    }
</div>

@implements IDisposable

@inject IChatService ChatService
@inject IChannelManager ChannelManager
@inject ILogger<Channels> Logger
@inject ILocalization Localization
@inject ICommunicationService CommunicationService

@code {

    private Modal _createGroupModal = default!;
    private readonly Dictionary<string, object> _modalParameters = [];

    private TextTable _table = default!;
    protected override Task OnInitializedAsync()
    {
        Logger.LogInformation("Channel count: {Count}", ChatService.AllChannels.Count());
        _table = Localization.GetTextTable(this);

        ChatService.ChannelChanged += StateHasChanged;
        ChatService.ConnectedUsersChanged += StateHasChanged;
        ChannelManager.ChannelsSorted += StateHasChanged;

        var hideModalCallback = EventCallback.Factory.Create(this, HideGroupModal);
        var createGroupCallback = EventCallback.Factory.Create<List<UserModel>>(this, CreateGroupChat);

        _modalParameters.Add(nameof(CreateGroupChatModal.CancelCallback), hideModalCallback);
        _modalParameters.Add(nameof(CreateGroupChatModal.CreateCallback), createGroupCallback);

        return CommunicationService.ConnectAsync();
    }

    public void Dispose()
    {
        ChatService.ChannelChanged -= StateHasChanged;
        ChatService.ConnectedUsersChanged -= StateHasChanged;
        ChannelManager.ChannelsSorted -= StateHasChanged;
    }

    private async Task DisplayGroupModal()
    {
        await _createGroupModal.ShowAsync<CreateGroupChatModal>(_table.CreateChannelModalTitle, parameters: _modalParameters);
    }

    private Task HideGroupModal() => _createGroupModal.HideAsync();

    private async Task CreateGroupChat(List<UserModel> selectedUsers)
    {
        await _createGroupModal.HideAsync();
        var id = await ChatService.CreateNewChannel(selectedUsers);

        Logger.LogInformation("Created channel id: {Id}", id);
    }
}
