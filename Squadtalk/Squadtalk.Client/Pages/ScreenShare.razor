@page "/ScreenShare"

@using Shared
@using Squadtalk.Client.Extensions
@implements IAsyncDisposable

<h3>WebRTC</h3>

<p class="my-2">
    <Button Color="ButtonColor.Primary" @onclick="ToggleShareScreen" disabled="@TokenIsEmpty">@JoinButtonText</Button>
    <Button Color="ButtonColor.Primary" @onclick="GenerateTokenAsync" disabled="@InvalidTokenData">Generate Token</Button>
</p>

@if (_joined)
{
    <p class="my-2">
        <Button Color="@MicrophoneButtonColor" @onclick="ToggleMicrophone"><Icon Name="@MicrophoneIconName"/></Button>
        @if (_microphoneEnabled)
        {
            <MediaDeviceSelector Devices="_microphones" ButtonText="Select microphone" DeviceSelected="MicrophoneSelected"/>
        }

        <Button Color="@CameraButtonColor" @onclick="ToggleCamera"><Icon Name="@CameraIconName"/></Button>
        @if (_cameraEnabled)
        {
            <MediaDeviceSelector Devices="_cameras" ButtonText="Select camera" DeviceSelected="CameraSelected"/>
        }

        <Button Color="@ScreenShareButtonColor" @onclick="ToggleScreenShare"><Icon Name="@ScreenShareIconName"/></Button>
    </p>
}

<div class="my-2">
    <label for="username-input" class="form-label">Username</label>
    <div class="col-md-6">
        <InputText id="username-input" @bind-Value="_username" class="form-control" Placeholder="Enter username"></InputText>
    </div>
</div>

<div class="my-2">
    <label for="room-input" class="form-label">Room</label>
    <div class="col-md-6">
        <InputText id="room-input" @bind-Value="_roomName" class="form-control" Placeholder="Enter room name"></InputText>
    </div>
</div>

<h2>Local</h2>

<div class="video-container my-2" id="local-video-container">
    <video class="video-frame" id="local-video" autoplay></video>
</div>

<h2>Remote</h2>

<div class="video-container my-2" id="remote-video-container">
    <video class="video-frame" id="remote-video" autoplay></video>
</div>

@inject IJSRuntime JSRuntime
@inject ToastService ToastService
@inject ILiveKitService LiveKitService
@inject NavigationManager NavigationManager
@inject ILogger<ScreenShare> Logger

@code {

    private bool _microphoneEnabled = true;
    private bool _cameraEnabled;
    private bool _screenShareEnabled;

    private ButtonColor MicrophoneButtonColor => _microphoneEnabled ? ButtonColor.Primary : ButtonColor.Danger;
    private ButtonColor CameraButtonColor => _cameraEnabled ? ButtonColor.Primary : ButtonColor.Danger;
    private ButtonColor ScreenShareButtonColor => _screenShareEnabled ? ButtonColor.Primary : ButtonColor.Danger;

    private IconName MicrophoneIconName => _microphoneEnabled ? IconName.MicFill : IconName.MicMuteFill;
    private IconName CameraIconName => _cameraEnabled ? IconName.CameraVideoFill : IconName.CameraVideoOffFill;
    private IconName ScreenShareIconName => _screenShareEnabled ? IconName.DisplayFill : IconName.XCircleFill;

    private MediaDeviceModel[]? _microphones;
    private MediaDeviceModel[]? _cameras;

    private string _username = string.Empty;
    private string _roomName = string.Empty;

    private bool InvalidTokenData => string.IsNullOrEmpty(_username) || string.IsNullOrEmpty(_roomName);
    private bool TokenIsEmpty => string.IsNullOrEmpty(_token);

    private string _token = string.Empty;
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<ScreenShare>? _dotNetObjectReference;

    private string JoinButtonText => _joined ? "Leave room" : "Join room";
    private bool _joined;

    private void MicrophoneSelected(MediaDeviceModel microphone)
    {
        Logger.LogInformation("Selected microphone {Microphone}", microphone.Label);
    }

    private void CameraSelected(MediaDeviceModel camera)
    {
        Logger.LogInformation("Selected camera {Camera}", camera.Label);
    }

    private async Task ToggleMicrophone()
    {
        _microphoneEnabled = !_microphoneEnabled;
        await _jsModule.TryInvokeVoidAsync("SetMicrophoneEnabled", _microphoneEnabled);
    }

    private async Task ToggleCamera()
    {
        _cameraEnabled = !_cameraEnabled;
        await _jsModule.TryInvokeVoidAsync("SetCameraEnabled", _cameraEnabled);
    }

    private async Task ToggleScreenShare()
    {
        _screenShareEnabled = !_screenShareEnabled;
        await _jsModule.TryInvokeVoidAsync("SetScreenShareEnabled", _screenShareEnabled);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _dotNetObjectReference = DotNetObjectReference.Create(this);
        _jsModule = await JSRuntime.ImportAndInitModuleAsync(JsModule.WebRTC, _dotNetObjectReference, $"{NavigationManager.BaseUri}jajo");
    }

    private async Task GenerateTokenAsync()
    {
        var token = await LiveKitService.CreateRoomTokenAsync(_username, _roomName);

        _token = token?.Token ?? string.Empty;

        var toastMessage = token is null
            ? new ToastMessage(ToastType.Warning, IconName.Key, "Failed to create token", "Failed to create token")
            : new ToastMessage(ToastType.Success, IconName.Key, "Token created", token.Token);

        ToastService.Notify(toastMessage);
    }

    private async Task ToggleShareScreen()
    {
        if (_joined)
        {
            _joined = false;
            await _jsModule.TryInvokeVoidAsync("Stop");

            return;
        }

        var stared = await _jsModule.TryInvokeAsync<bool>("Start", _token);
        if (!stared) return;

        _joined = true;
    }

    [JSInvokable]
    public void OnLocalTrackUnpublished()
    {
        _joined = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnMicrophonesUpdated(MediaDeviceModel[] microphones)
    {
        _microphones = microphones;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnCamerasUpdated(MediaDeviceModel[] cameras)
    {
        _cameras = cameras;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnError(string error)
    {
        ToastService.Notify(new ToastMessage(ToastType.Warning, error));
    }

    public async ValueTask DisposeAsync()
    {
        await _jsModule.TryInvokeVoidAsync("Stop");
        await _jsModule.TryDisposeAsync();

        _dotNetObjectReference?.Dispose();
    }
}
