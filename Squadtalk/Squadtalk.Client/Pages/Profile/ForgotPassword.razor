@page "/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using Shared
@using Shared.DTOs.Account
@using RestSharp

<MudContainer MaxWidth="MaxWidth.ExtraSmall">
    <MudPaper Class="pa-4" Elevation="8">
        <MudForm @ref="_form" @bind-IsValid="_formValid">

            <MudTextField T="string" Label="Email" Required="true" RequiredError="Email is required"
                          Validation="@(new EmailAddressAttribute { ErrorMessage = "The email address is invalid!" })"
                          @ref="_emailField" />

            <MudButton Class="mt-4" Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="ResetPassword" Disabled="@(!_formValid)">
                Reset password
            </MudButton>

        </MudForm>
    </MudPaper>
</MudContainer>

@inject NavigationManager NavigationManager
@inject RestClient RestClient
@inject ISnackbar Snackbar

@code
{
    private MudForm _form = default!;
    private MudTextField<string> _emailField = default!;

    private bool _formValid;

    private async Task ResetPassword()
    {
        if (!_form.IsValid) return;

        var request = new RestRequest(Endpoints.ForgotPassword)
            .AddBody(new ForgotPasswordDto
            {
                Email = _emailField.Value!
            });

        try
        {
            var response = await RestClient.PostAsync(request);
            if (response.IsSuccessful)
            {
                NavigationManager.NavigateTo("Profile/ForgotPasswordConfirmation");
            }
        }
        catch
        {
            Snackbar.Add("Failed to request password reset", Severity.Error);
        }
    }
}