@attribute [Route(Routes.Pages.ForgotPassword)]

@using System.ComponentModel.DataAnnotations
@using Shared.DTOs.Account
@using RestSharp

<MudContainer MaxWidth="MaxWidth.ExtraSmall">
    <MudPaper Class="pa-4" Elevation="8">
        <MudForm @ref="_form" @bind-IsValid="_formValid">

            <MudTextField T="string" Label="@LocalizedText.R.email" Required="true"
                          RequiredError="@LocalizedText.R.email_is_required"
                          Validation="@(new EmailAddressAttribute { ErrorMessage = LocalizedText.R.email_is_invalid })"
                          @ref="_emailField" />

            <MudButton Class="mt-4" Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="ResetPassword" Disabled="@(!_formValid)">
                @LocalizedText.R.reset_password
            </MudButton>

        </MudForm>
    </MudPaper>
</MudContainer>

@inject NavigationManager NavigationManager
@inject RestClient RestClient
@inject ISnackbar Snackbar
@inject LocalizedText LocalizedText

@code
{
    private MudForm _form = default!;
    private MudTextField<string> _emailField = default!;

    private bool _formValid;

    private async Task ResetPassword()
    {
        if (!_form.IsValid) return;

        var request = new RestRequest(Routes.Endpoints.ForgotPassword)
            .AddBody(new ForgotPasswordDto
            {
                Email = _emailField.Value!
            });

        try
        {
            var response = await RestClient.PostAsync(request);
            if (response.IsSuccessful)
            {
                NavigationManager.NavigateTo(Routes.Pages.ForgotPasswordConfirmation);
            }
            else
            {
                var template = LocalizedText.R.failed_to_request_password_reset_code_template;
                var message = string.Format(template, (int) response.StatusCode);
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add(LocalizedText.R.failed_to_request_password_reset, Severity.Error);
        }
    }
}