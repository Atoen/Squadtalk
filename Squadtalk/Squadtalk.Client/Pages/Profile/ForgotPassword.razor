@attribute [Route(Routes.Pages.ForgotPassword)]

@using Shared.Data.Results
@using Shared.DTOs.Account
@using Squadtalk.Client.Services

<MudContainer MaxWidth="MaxWidth.ExtraSmall">
    <MudPaper Class="pa-4" Elevation="8">

        <MudForm @ref="_form" Spacing="1">

            <MudText Typo="Typo.h5" Color="Color.Primary">@LocalizedText.R.recover_account</MudText>

            <MudTextField T="string" Label="@LocalizedText.R.email" Required="true"
                          RequiredError="@LocalizedText.R.email_is_required"
                          Validation="FormValidator.EmailValidator"
                          @ref="_emailField" InputType="InputType.Email" InputMode="InputMode.email"/>

            <MudButton Class="mt-4" Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="ResetPassword" Disabled="_working">
                @if (_working)
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Default" Size="Size.Small"/>
                }
                else
                {
                    @LocalizedText.R.reset_password
                }
            </MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>

@inject NavigationManager NavigationManager
@inject IAccountManager AccountManager
@inject ISnackbar Snackbar
@inject LocalizedText LocalizedText
@inject FormValidator FormValidator

@code
{
    private MudForm _form = default!;
    private MudTextField<string> _emailField = default!;

    private bool _working;

    private async Task ResetPassword()
    {
        if (!_form.IsValid || _working) return;

        _working = true;

        var data = new ForgotPasswordDto
        {
            Email = _emailField.Value!
        };

        var result = await AccountManager.ForgotPasswordAsync(data);

        _working = false;

        switch (result)
        {
            case ForgotPasswordResult.Success:
                NavigationManager.NavigateTo(Routes.Pages.ForgotPasswordConfirmation);
                break;

            case ForgotPasswordResult.Fail:
                Snackbar.Add(LocalizedText.R.failed_to_request_password_reset, Severity.Error);
                break;

            case ForgotPasswordResult.NetworkError:
                Snackbar.Add(LocalizedText.R.network_error, Severity.Error);
                break;
        }
    }
}