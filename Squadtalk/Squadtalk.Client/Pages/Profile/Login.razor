@attribute [Route(Routes.Pages.Login)]
@using Shared.Data.Results
@using Shared.DTOs.Account

<MudContainer MaxWidth="MaxWidth.Small">
    <MudPaper Class="pa-4" Elevation="8">
        <MudForm @ref="_form" @bind-IsValid="_formValid">
            <MudTextField T="string" Label="@LocalizedText.R.username" Required="true"
                          RequiredError="@LocalizedText.R.username_is_required" @ref="_usernameField"/>

            <MudTextField T="string" Label="@LocalizedText.R.password" Required="true"
                          RequiredError="@LocalizedText.R.password_is_required"
                          @ref="_passwordField" InputType="InputType.Password"/>

            <MudCheckBox T="bool" Label="@LocalizedText.R.remember_me" Color="Color.Primary"
                         @ref="_rememberCheckBox"/>

            <MudStack Class="mt-4 px-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_formValid)" OnClick="LoginUser">
                    @LocalizedText.R.login
                </MudButton>
                <MudButton Variant="Variant.Text" OnClick="NavigateToRegister">
                    @LocalizedText.R.register_as_new_user
                </MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="NavigateToForgotPassword">
                    @LocalizedText.R.forgot_password
                </MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ResendConfirmation">
                    @LocalizedText.R.resend_confirmation_email
                </MudButton>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudContainer>

@inject NavigationManager NavigationManager
@inject IUserAuthenticationService UserAuthenticationService
@inject ISnackbar Snackbar
@inject LocalizedText LocalizedText
@inject IAccountManager AccountManager

@code
{
    private MudForm _form = default!;
    private MudTextField<string> _usernameField = default!;
    private MudTextField<string> _passwordField = default!;
    private MudCheckBox<bool> _rememberCheckBox = default!;

    private bool _formValid;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        if (UserAuthenticationService.IsAuthenticated)
        {
            NavigateOnLogin();
        }
    }

    private async Task LoginUser()
    {
        if (!_form.IsValid) return;

        var data = new UserLoginDto
        {
            Username = _usernameField.Value!,
            Password = _passwordField.Value!,
            Remember = _rememberCheckBox.Value
        };

        var result = await AccountManager.LoginAsync(data);

        if (result == LoginResult.Success)
        {
            NavigateOnLogin();
        }
        else if (result == LoginResult.Fail)
        {
            Snackbar.Add(LocalizedText.R.failed_to_log_in, Severity.Warning);
        }
        else
        {
            Snackbar.Add(LocalizedText.R.network_error, Severity.Error);
        }
    }

    private void NavigateOnLogin()
    {
        var returnUrl = ReturnUrl ?? string.Empty;
        NavigationManager.NavigateTo(Uri.UnescapeDataString(returnUrl), forceLoad: true);
    }

    private void NavigateToRegister()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(Routes.Pages.Register, new Dictionary<string, object?>
        {
            ["ReturnUrl"] = ReturnUrl
        });

        NavigationManager.NavigateTo(uri);
    }

    private void NavigateToForgotPassword() => NavigationManager.NavigateTo(Routes.Pages.ForgotPassword);

    private void ResendConfirmation()
    {
        Snackbar.Add(LocalizedText.R.confirmation_email_resent, Severity.Success);
    }
}