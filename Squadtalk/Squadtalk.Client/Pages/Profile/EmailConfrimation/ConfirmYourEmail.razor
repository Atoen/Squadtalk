@page "/Profile/ConfirmEmail"

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudAlert Elevation="8" Variant="Variant.Filled" Severity="Severity.Info">
        Please check your email to confirm the account.
    </MudAlert>

    <MudButton Class="ma-4" Color="Color.Info" Variant="Variant.Text">Resend confirmation email</MudButton>
</MudContainer>

