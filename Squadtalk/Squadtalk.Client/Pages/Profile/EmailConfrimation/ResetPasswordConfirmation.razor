@page "/Profile/ResetPasswordConfirmation"

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudAlert Elevation="8" Variant="Variant.Filled" Severity="Severity.Info">
        @LocalizedText.R.password_reset
    </MudAlert>

    <MudButton Class="ma-4" Color="Color.Info" Variant="Variant.Filled" Href="Profile/Login">
        @LocalizedText.R.log_in
    </MudButton>
</MudContainer>

@inject LocalizedText LocalizedText
