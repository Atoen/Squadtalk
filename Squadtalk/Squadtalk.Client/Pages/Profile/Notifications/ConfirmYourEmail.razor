@page "/Profile/ConfirmEmail"

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudAlert Elevation="8" Variant="Variant.Filled" Severity="Severity.Info">
        @LocalizedText.R.confirm_your_email
    </MudAlert>

    <MudButton Class="ma-4" Color="Color.Info" Variant="Variant.Text">
        @LocalizedText.R.resend_confirmation_email
    </MudButton>
</MudContainer>

@inject LocalizedText LocalizedText
