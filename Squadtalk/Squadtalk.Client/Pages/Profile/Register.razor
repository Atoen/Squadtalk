@attribute [Route(Routes.Pages.Register)]

@using Shared.Data.Results
@using Shared.DTOs.Account
@using Squadtalk.Client.Services
@using Color = MudBlazor.Color

<MudContainer MaxWidth="MaxWidth.Small">
    <MudPaper Class="pa-4" Elevation="8">

        <MudForm @ref="_form" Spacing="1">

            <MudText Typo="Typo.h5" Color="Color.Primary">@LocalizedText.R.register</MudText>

            <MudTextField T="string" Label="@LocalizedText.R.username" Required="true" Immediate="true" InputType="InputType.Text"
                          InputMode="InputMode.text" Counter="@FormValidator.MaximumUsernameLength"
                          Error="@(_usernameError is not null)" ErrorText="@_usernameError"
                          RequiredError="@LocalizedText.R.username_is_required" @ref="_usernameField"
                          Validation="FormValidator.UsernameValidator"/>

            <MudTextField T="string" Label="@LocalizedText.R.email" Required="true" InputType="InputType.Email"
                          Immediate="true" Error="@(_emailError is not null)" ErrorText="@_emailError"
                          RequiredError="@LocalizedText.R.email_is_required" InputMode="InputMode.email"
                          Validation="FormValidator.EmailValidator"
                          @ref="_emailField"/>

            <MudTextField T="string" Label="@LocalizedText.R.password" Required="true"
                          RequiredError="@LocalizedText.R.password_is_required" InputType="InputType.Password"
                          @ref="_passwordField" Immediate="true"
                          Validation="FormValidator.PasswordValidator"/>

            <MudTextField T="string" Label="@LocalizedText.R.password" Required="true"
                          HelperText="@LocalizedText.R.confirm_password" InputType="InputType.Password"
                          Validation="@(new Func<string, string?>(PasswordMatch))" Immediate="true"/>

            <MudStack Class="mt-4" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width: 200px;"
                           Disabled="_working" OnClick="RegisterUser">
                    @if (_working)
                    {
                        <MudProgressCircular Indeterminate="true" Color="Color.Default" Size="Size.Small"/>
                    }
                    else
                    {
                        @LocalizedText.R.create_account
                    }
                </MudButton>

                <MudButton Variant="Variant.Text" OnClick="NavigateToLogin">
                    @LocalizedText.R.login_to_existing_account
                </MudButton>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudContainer>

@inject NavigationManager NavigationManager
@inject IAccountManager AccountManager
@inject ISnackbar Snackbar
@inject LocalizedText LocalizedText
@inject FormValidator FormValidator

@code
{
    private MudForm _form = default!;
    private MudTextField<string> _usernameField = default!;
    private MudTextField<string> _emailField = default!;
    private MudTextField<string> _passwordField = default!;

    private bool _working;

    private string? _usernameError;
    private string? _emailError;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private async Task RegisterUser()
    {
        await _form.Validate();

        if (!_form.IsValid || _working) return;

        _working = true;
        _usernameError = null;
        _emailError = null;

        var username = _usernameField.Value!;
        var email = _emailField.Value!;

        var data = new UserRegisterDto
        {
            Username = username,
            Email = email,
            Password = _passwordField.Value!
        };

        var result = await AccountManager.RegisterAsync(data);

        _working = false;

        HandleResult(result);
    }

    private void HandleResult(RegisterResult result)
    {
        switch (result)
        {
            case RegisterResult.Success:
                NavigationManager.NavigateTo(Routes.Pages.ConfirmEmail);
                break;

            case RegisterResult.EmailInUse:
                _emailError = LocalizedText.R.this_email_in_use;
                break;

            case RegisterResult.UsernameInUse:
                _usernameError = LocalizedText.R.this_username_in_use;
                break;

            case RegisterResult.FailedToCreateAccount:
                Snackbar.Add(LocalizedText.R.failed_to_create_account, Severity.Error);
                break;

            case RegisterResult.NetworkError:
                Snackbar.Add(LocalizedText.R.network_error, Severity.Error);
                break;
        }
    }

    private void NavigateToLogin()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(Routes.Pages.Login, new Dictionary<string, object?>
        {
            { "ReturnUrl", ReturnUrl }
        });

        NavigationManager.NavigateTo(uri);
    }

    private string? PasswordMatch(string? arg)
    {
        return _passwordField.Value != arg ? LocalizedText.R.passwords_dont_match : null;
    }
}