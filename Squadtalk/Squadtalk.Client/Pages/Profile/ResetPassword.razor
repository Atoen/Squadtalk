@attribute [Route(Routes.Pages.ResetPassword)]

@using Shared.Data.Results
@using Shared.DTOs.Account

<MudContainer MaxWidth="MaxWidth.ExtraSmall">
    <MudPaper Class="pa-4" Elevation="8">

        <MudForm @ref="_form" Spacing="1">

            <MudText Typo="Typo.h5" Color="Color.Primary">@LocalizedText.R.account_recovering</MudText>

            <MudTextField T="string" Label="@LocalizedText.R.new_password" Required="true"
                          RequiredError="@LocalizedText.R.new_password_required"
                          InputType="InputType.Password" @ref="_passwordField"
                          Validation="@FormValidator.PasswordValidator"/>

            <MudTextField T="string" Label="@LocalizedText.R.password" Required="true"
                          RequiredError="@LocalizedText.R.new_password_confirmation_required"
                          HelperText="@LocalizedText.R.confirm_password" InputType="InputType.Password"
                          Validation="@(new Func<string, string?>(PasswordMatch))" Immediate="true"/>

            <MudButton Class="mt-4" Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="ResetUserPassword" Disabled="_working">
                @if (_working)
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Default" Size="Size.Small"/>
                }
                else
                {
                    @LocalizedText.R.set_password_new
                }
            </MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>

@inject NavigationManager NavigationManager
@inject IAccountManager AccountManager
@inject LocalizedText LocalizedText
@inject ISnackbar Snackbar
@inject IFormValidator FormValidator

@code
{
    private MudForm _form = default!;
    private MudTextField<string> _passwordField = default!;

    private bool _working;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override void OnInitialized()
    {
        if (UserId is null || Code is null)
        {
            NavigationManager.NavigateTo(Routes.Pages.InvalidPasswordReset);
        }
    }

    private async Task ResetUserPassword()
    {
        await _form.Validate();

        if (!_form.IsValid || _working) return;

        _working = true;

        var data = new ResetPasswordDto
        {
            UserId = UserId!,
            Code = Code!,
            NewPassword = _passwordField.Value!
        };

        var result = await AccountManager.ResetPasswordAsync(data);

        _working = false;

        switch (result)
        {
            case ResetPasswordResult.Success:
                NavigationManager.NavigateTo(Routes.Pages.ResetPasswordConfirmation);
                break;

            case ResetPasswordResult.Fail:
                Snackbar.Add(LocalizedText.R.failed_to_reset_password, Severity.Warning);
                break;

            case ResetPasswordResult.NetworkError:
                Snackbar.Add(LocalizedText.R.network_error, Severity.Error);
                break;
        }
    }

    private string? PasswordMatch(string arg)
    {
        return FormValidator.PasswordMatches(_passwordField.Value, arg);
    }
}
