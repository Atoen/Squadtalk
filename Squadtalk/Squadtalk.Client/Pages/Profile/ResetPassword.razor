@page "/ResetPassword"

@using System.Text.RegularExpressions
@using Shared
@using Shared.DTOs.Account
@using RestSharp

<MudContainer MaxWidth="MaxWidth.ExtraSmall">
    <MudPaper Class="pa-4" Elevation="8">
        <MudForm @ref="_form" @bind-IsValid="_formValid">


            <MudTextField T="string" Label="New password" Required="true" RequiredError="Password is required!"
                          InputType="InputType.Password" @ref="_passwordField"
                          Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))"/>

            <MudTextField T="string"
                          Label="Password" HelperText="Repeat the password" InputType="InputType.Password"
                          Validation="@(new Func<string, string?>(PasswordMatch))"/>

            <MudButton Class="mt-4" Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="ResetUserPassword" Disabled="@(!_formValid)">
                @LocalizedText.R.reset_password
            </MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>


@inject NavigationManager NavigationManager
@inject RestClient RestClient
@inject LocalizedText LocalizedText
@inject ISnackbar Snackbar

@code
{
    private MudForm _form = default!;
    private MudTextField<string> _passwordField = default!;

    private bool _formValid;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override void OnInitialized()
    {
        if (UserId is null || Code is null)
        {
            NavigationManager.NavigateTo("Profile/InvalidPasswordReset");
        }
    }

    private async Task ResetUserPassword()
    {
        if (!_form.IsValid) return;

        var request = new RestRequest(Endpoints.ResetPassword)
            .AddBody(new ResetPasswordDto
            {
                UserId = UserId!,
                Code = Code!,
                NewPassword = _passwordField.Value!
            });

        try
        {
            var response = await RestClient.PostAsync(request);
            if (response.IsSuccessful)
            {
                NavigationManager.NavigateTo("Profile/ResetPasswordConfirmation");
            }
        }
        catch (Exception e)
        {
            Snackbar.Add("Failed to reset password", Severity.Error);
        }
    }

    private IEnumerable<string> PasswordStrength(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
        {
            yield return "Password is required!";
            yield break;
        }

        if (password.Length < 8)
        {
            yield return "Password must be at least of length 8";
        }
        if (!Regex.IsMatch(password, "[A-Z]"))
        {
            yield return "Password must contain at least one capital letter";
        }
        if (!Regex.IsMatch(password, "[a-z]"))
        {
            yield return "Password must contain at least one lowercase letter";
        }
        if (!Regex.IsMatch(password, "[0-9]"))
        {
            yield return "Password must contain at least one digit";
        }
    }

    private string? PasswordMatch(string arg)
    {
        return _passwordField.Value != arg ? "Passwords don't match" : null;
    }
}
