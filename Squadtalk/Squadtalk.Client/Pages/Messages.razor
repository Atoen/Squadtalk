@page "/Messages"
@using Microsoft.AspNetCore.Authorization
@using Squadtalk.Client.Layout

@attribute [Authorize]
@layout ChatLayout

<PageTitle>Squadtalk | Messages</PageTitle>

<ChannelSelector />

@inject ICommunicationService CommunicationService
@inject IChatService ChatService

@code {
    
    protected override async Task OnInitializedAsync()
    {
        await ChatService.ClearChannelSelectionAsync();
        await CommunicationService.ConnectAsync();
    }
}
