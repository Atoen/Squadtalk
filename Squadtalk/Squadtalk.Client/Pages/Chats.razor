@attribute [Route(Routes.Pages.Chats)]

@using Microsoft.AspNetCore.Authorization
@using Squadtalk.Client.Components.dialogs

@attribute [Authorize]

<PageTitle>Squadtalk | @LocalizedText.R.messages</PageTitle>

<div class="channels">
    <div>
        @{ var globalUnread = ChannelManager.GlobalChat.UnreadMessages; }

        <MudBadge Content="globalUnread" Color="Color.Error" Style="max-width: 200px"
                  Overlap="true"
                  Visible="@(globalUnread > 0)">
            <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Rounded.Public"
                       OnClick="() => ChannelManager.OpenChannelAsync(ChannelManager.GlobalChat)">
                @LocalizedText.R.global_chat
            </MudButton>
        </MudBadge>
    </div>

    <p class="mud-typography-body1 d-flex align-center">
        @LocalizedText.R.private_messages

        <MudButton Class="ms-10 mud-typography-body1" Size="Size.Small" Color="Color.Primary"
                   OnClick="ShowCreateGroupDialog">
            @LocalizedText.R.add_new_chat
        </MudButton>
    </p>

    @foreach (var channel in ChannelSorter.SortedChannels)
    {
        <ChatTemplate @key="channel.Id" Channel="@channel"/>
    }
</div>

@implements IDisposable

@inject IChannelManager ChannelManager
@inject IChannelSorter ChannelSorter
@inject LocalizedText LocalizedText
@inject IConnectionService ConnectionService
@inject IDialogService DialogService

@code
{
    protected override async Task OnInitializedAsync()
    {
        await ConnectionService.ConnectAsync();
    }

    private DialogParameters<SelectFriendsDialog>? _dialogParameters;
    private DialogOptions? _dialogOptions;

    private async Task CreateGroupAsync(List<UserModel> invitedUsers)
    {
        if (invitedUsers is [var singleUser])
        {
            await ChannelManager.OpenOrCreateTemporaryDirectMessageChannelAsync(singleUser);
            return;
        }

        await ChannelManager.CreateNewChannelAsync(invitedUsers);
    }

    private Task ShowCreateGroupDialog()
    {
        _dialogParameters ??= new DialogParameters<SelectFriendsDialog>
        {
            { x => x.OnSelection, EventCallback.Factory.Create<List<UserModel>>(this, CreateGroupAsync) }
        };

        _dialogOptions ??= new DialogOptions { Position = DialogPosition.TopCenter };

        return DialogService.ShowAsync<SelectFriendsDialog>(LocalizedText.R.select_friends, _dialogParameters, _dialogOptions);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;

        ChannelManager.ChannelsListChanged += StateHasChanged;
        ChannelManager.ChannelChanged += StateHasChanged;
        ChannelSorter.ChannelsSorted += StateHasChanged;
    }

    public void Dispose()
    {
        if (!RendererInfo.IsInteractive) return;

        ChannelManager.ChannelsListChanged -= StateHasChanged;
        ChannelManager.ChannelChanged -= StateHasChanged;
        ChannelSorter.ChannelsSorted -= StateHasChanged;
    }
}
