@attribute [Route(Routes.Pages.Chats)]

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Squadtalk | Messages</PageTitle>

@* <Modal @ref="_createGroupModal" Size="ModalSize.Regular" *@
@*        UseStaticBackdrop="true" HeaderCssClass="justify-content-between"/> *@

<div class="channels">
    <div>
        @{ var globalUnread = ChannelManager.GlobalChat.UnreadMessages; }

        <MudBadge Content="globalUnread" Color="Color.Error" Style="max-width: 150px"
                  Overlap="true"
                  Visible="@(globalUnread > 0)">
            <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Rounded.Public"
                       OnClick="() => ChannelManager.OpenChannelAsync(ChannelManager.GlobalChat)">
                Global
            </MudButton>
        </MudBadge>
    </div>

    @* <Button Color="ButtonColor.Primary" @onclick="DisplayGroupModal" TooltipTitle="@_table.CreateChannelTooltip" *@
    @*         TooltipColor="TooltipColor.Dark"> *@
    @*     $1$ <Icon Name="IconName.PlusSquare" Size="IconSize.x5"/> #1# *@
    @* </Button> *@

    @foreach (var channel in ChannelSorter.SortedChannels)
    {
        <ChatTemplate @key="channel.Id" Model="@channel"/>
    }
</div>

@implements IDisposable

@inject IChannelManager ChannelManager
@inject IChannelSorter ChannelSorter
@inject ILogger<Chats> Logger
@* @inject ILocalization Localization *@
@inject IConnectionService ConnectionService

@code
{
    // private Modal _createGroupModal = default!;
