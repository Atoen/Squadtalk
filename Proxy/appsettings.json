{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "frontend": {
        "ClusterId": "Frontend",
        "Match": {
          "Hosts": [ "*" ]
        }
      },
      "livekit": {
        "ClusterId": "LiveKit",
        "Match": {
          "Path": "/jajo/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/jajo"
          }
        ]
      },
      "ng": {
        "ClusterId": "Angular",
        "Match": {
          "Path": "/ng/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "Frontend": {
        "Destinations": {
          "FrontendDestination": {
            "Address": "http://localhost:1235"
          }
        }
      },
      "LiveKit": {
        "Destinations": {
          "LiveKitDestination": {
            "Address": "http://localhost:7880"
          }
        }
      },
      "Angular": {
        "Destinations": {
          "LiveKitDestination": {
            "Address": "http://localhost:4200"
          }
        }
      }
    }
  }
}

